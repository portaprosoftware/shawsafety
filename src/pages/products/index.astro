---
import { getCollection } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import ProductCard from '@components/ui/cards/ProductCard.astro';
import SpecModal from '@components/ui/blocks/SpecModal.astro';
import SectionHeading from '@components/ui/blocks/SectionHeading.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import { SITE } from '@data/constants';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order
);

const categories = [
  { id: 'zip-ties', label: 'Safety Ties' },
  { id: 'vests', label: 'Safety Vests' },
] as const;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/products`,
  url: `${SITE.url}/products`,
  name: `All Products | ${SITE.title}`,
  description: SITE.description_short,
  inLanguage: 'en-US',
};
---

<MainLayout
  title={`All Products | ${SITE.title}`}
  customDescription="Browse every Shaw Safety product: 11-inch fluorescent security zip ties in four colors and ANSI Class 2 hi-vis safety vests. Volume pricing on every SKU."
  structuredData={structuredData}
>
  <section class="py-14 lg:py-20">
    <SectionHeading
      title="All Products"
      subTitle="A short catalogue on purpose. We stock what intermodal yards and fleets actually reorder, and we keep it in stock."
    />
  </section>

  {
    categories.map(category => {
      const items = products.filter(p => p.data.category === category.id);
      if (!items.length) return null;
      return (
        <section class="pb-16">
          <h2 class="text-2xl font-bold tracking-tight text-neutral-900">
            {category.label}
          </h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {items.flatMap(product =>
              product.data.variants.map(variant => (
                <ProductCard product={product} variantId={variant.id} />
              ))
            )}
          </div>
        </section>
      );
    })
  }

  <PricingSection
    title="Volume Pricing On Every SKU"
    subTitle="The same ladder applies across the catalogue. Quantity is totaled across colors, so a mixed order still reaches the next tier."
  />

  <SpecModal />
</MainLayout>
