---
import MainLayout from '@/layouts/MainLayout.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { SITE } from '@data/constants';
import { getVariantCatalog } from '@utils/variantCatalog';

/**
 * The catalogue, embedded so a `?reorder=` link (from a confirmation page or
 * an order email) can rebuild real cart lines from bare variant ids. Prices
 * come from these tiers exactly as a hand-added line's would, and Stripe
 * reprices everything server-side regardless, so the link itself never
 * carries money.
 */
const catalog = Object.fromEntries(
  (await getVariantCatalog()).map(line => [line.variantId, line])
);
---

<MainLayout
  title={`Your Cart | ${SITE.title}`}
  customDescription="Review your Shaw Safety order before checkout."
>
  <section class="py-14 lg:py-20">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
      Your Cart
    </h1>

    <div id="page-cart-empty" class="mt-10 hidden">
      <div
        class="flex flex-col items-center gap-4 rounded-2xl border border-neutral-200 bg-neutral-50 py-20 text-center"
      >
        <Icon name="cart" class="h-12 w-12 text-neutral-300" />
        <p class="text-neutral-600">Your cart is empty.</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/products"
            class="bg-maroon-700 hover:bg-maroon-800 rounded-lg px-6 py-3 text-sm font-bold text-white transition"
          >
            Browse Products
          </a>
          {/* Unhidden by the script when a previous order is remembered. */}
          <button
            type="button"
            id="page-cart-reorder"
            class="hidden items-center gap-2 rounded-lg border border-neutral-300 px-6 py-3 text-sm font-bold text-neutral-800 transition hover:border-neutral-500"
          >
            <Icon name="refresh" class="h-4 w-4" />
            <span data-label>Reorder Your Last Order</span>
          </button>
        </div>
      </div>
    </div>

    <div id="page-cart-content" class="mt-10 hidden gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div id="page-cart-lines" class="divide-y divide-neutral-200"></div>
        <button
          type="button"
          id="page-cart-clear"
          class="mt-6 text-sm font-semibold text-neutral-500 underline underline-offset-4 transition hover:text-red-600"
        >
          Clear cart
        </button>
      </div>

      <aside class="lg:col-span-1">
        <div
          class="rounded-2xl border border-neutral-200 bg-neutral-50 p-6 lg:sticky lg:top-32"
        >
          <h2 class="text-lg font-bold text-neutral-900">Order Summary</h2>

          <dl class="mt-5 space-y-2.5 text-sm">
            <div class="flex justify-between">
              <dt class="text-neutral-600">Items</dt>
              <dd id="page-cart-count" class="font-semibold text-neutral-900">
              </dd>
            </div>
            <div id="page-cart-savings-row" class="hidden justify-between">
              <dt class="text-neutral-600">Volume savings</dt>
              <dd id="page-cart-savings" class="font-semibold text-green-700">
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-neutral-600">Shipping</dt>
              <dd
                id="page-cart-shipping"
                class="font-semibold text-neutral-900"
              >
              </dd>
            </div>
          </dl>

          <div
            class="mt-5 flex items-baseline justify-between border-t border-neutral-200 pt-5"
          >
            <span class="font-semibold text-neutral-900">Subtotal</span>
            <span
              id="page-cart-subtotal"
              class="text-2xl font-bold tracking-tight text-neutral-900"></span>
          </div>
          <p class="mt-1 text-xs text-neutral-500">
            Taxes calculated at checkout.
          </p>

          <button
            type="button"
            id="page-cart-checkout"
            class="bg-maroon-700 hover:bg-maroon-800 focus-visible:ring-maroon-700 mt-5 w-full rounded-lg px-5 py-3.5 text-sm font-bold text-white transition focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-60"
          >
            Checkout
          </button>
          <p
            id="page-cart-note"
            class="bg-maroon-50 text-maroon-900 mt-3 hidden rounded-lg px-3 py-2 text-xs font-medium"
            role="status"
          >
          </p>
        </div>
      </aside>
    </div>
  </section>
</MainLayout>

<script is:inline define:vars={{ catalog }}>
  window.__shawVariantCatalog = catalog;
</script>

<script>
  import {
    subscribe,
    updateQty,
    removeItem,
    replaceItems,
    clear,
    getItems,
    unitPriceFor,
    FREE_SHIPPING_THRESHOLD,
    type CartItem,
  } from '@scripts/cart';
  import { formatMoney, lineTotal, savingsPercent } from '@scripts/pricing';
  import { checkout } from '@scripts/checkout';
  import {
    loadLastOrder,
    parseReorder,
    type ReorderLine,
  } from '@scripts/reorder';
  import type { CatalogLine } from '@utils/variantCatalog';

  const lines = document.getElementById('page-cart-lines');
  const content = document.getElementById('page-cart-content');
  const empty = document.getElementById('page-cart-empty');
  const countEl = document.getElementById('page-cart-count');
  const subtotalEl = document.getElementById('page-cart-subtotal');
  const savingsEl = document.getElementById('page-cart-savings');
  const savingsRow = document.getElementById('page-cart-savings-row');
  const shippingEl = document.getElementById('page-cart-shipping');
  const checkoutBtn = document.getElementById(
    'page-cart-checkout'
  ) as HTMLButtonElement | null;
  const note = document.getElementById('page-cart-note');

  const renderLine = (item: CartItem) => {
    const unit = unitPriceFor(item);
    const saved = savingsPercent(item.tiers, unit);
    return `
      <div class="flex gap-4 py-5" data-key="${item.key}">
        <a href="${item.href}" class="relative shrink-0">
          <img src="${item.image}" alt="" width="96" height="96"
            class="h-24 w-24 rounded-lg border border-neutral-200 bg-white object-contain p-2" />
          <span class="absolute -right-1 -bottom-1 h-5 w-5 rounded-full border-2 border-white" style="background:${item.hex}"></span>
        </a>
        <div class="min-w-0 flex-1">
          <a href="${item.href}" class="font-semibold text-neutral-900 hover:text-maroon-700">${item.title}</a>
          <p class="mt-0.5 text-sm text-neutral-500">${item.variantName} &middot; SKU ${item.sku}</p>
          <p class="mt-1 text-sm font-medium text-neutral-700">
            ${formatMoney(unit)} / ${item.unit}
            ${saved > 0 ? `<span class="ml-1 font-semibold text-green-700">${saved}% off</span>` : ''}
          </p>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
            <div class="inline-flex items-center rounded-lg border border-neutral-300">
              <button type="button" data-act="dec" aria-label="Decrease quantity"
                class="px-3 py-2 text-neutral-600 transition hover:bg-neutral-100">&minus;</button>
              <input type="number" min="1" value="${item.qty}" data-act="qty" aria-label="Quantity"
                class="w-14 border-0 bg-transparent p-0 text-center text-sm font-semibold focus:ring-0" />
              <button type="button" data-act="inc" aria-label="Increase quantity"
                class="px-3 py-2 text-neutral-600 transition hover:bg-neutral-100">+</button>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-lg font-bold text-neutral-900">${formatMoney(lineTotal(item.tiers, item.qty))}</span>
              <button type="button" data-act="remove"
                class="text-sm font-medium text-neutral-500 underline underline-offset-4 transition hover:text-red-600">Remove</button>
            </div>
          </div>
        </div>
      </div>`;
  };

  subscribe((items, totals) => {
    const hasItems = items.length > 0;
    if (lines) lines.innerHTML = items.map(renderLine).join('');
    empty?.classList.toggle('hidden', hasItems);
    content?.classList.toggle('hidden', !hasItems);
    content?.classList.toggle('grid', hasItems);

    if (countEl) countEl.textContent = String(totals.count);
    if (subtotalEl) subtotalEl.textContent = formatMoney(totals.subtotal);
    if (savingsEl) savingsEl.textContent = `-${formatMoney(totals.savings)}`;
    if (savingsRow) {
      savingsRow.classList.toggle('hidden', totals.savings <= 0);
      savingsRow.classList.toggle('flex', totals.savings > 0);
    }
    if (shippingEl)
      shippingEl.textContent =
        totals.subtotal >= FREE_SHIPPING_THRESHOLD
          ? 'Free'
          : 'Calculated at checkout';
    note?.classList.add('hidden');
  });

  lines?.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
    const row = (e.target as HTMLElement).closest<HTMLElement>('[data-key]');
    if (!btn || !row) return;
    const key = row.dataset.key!;
    const qty = Number(
      row.querySelector<HTMLInputElement>('[data-act="qty"]')?.value ?? 1
    );
    if (btn.dataset.act === 'inc') updateQty(key, qty + 1);
    if (btn.dataset.act === 'dec') updateQty(key, qty - 1);
    if (btn.dataset.act === 'remove') removeItem(key);
  });

  lines?.addEventListener('change', e => {
    const input = e.target as HTMLInputElement;
    if (input.dataset.act !== 'qty') return;
    const row = input.closest<HTMLElement>('[data-key]');
    if (row) updateQty(row.dataset.key!, Number(input.value));
  });

  document.getElementById('page-cart-clear')?.addEventListener('click', clear);

  checkoutBtn?.addEventListener('click', async () => {
    checkoutBtn.disabled = true;
    checkoutBtn.textContent = 'Starting checkout…';
    const result = await checkout(getItems());

    // On success the browser is already navigating to Stripe.
    if (result.ok) return;

    checkoutBtn.disabled = false;
    checkoutBtn.textContent = 'Checkout';
    if (note) {
      note.textContent = result.message;
      note.classList.remove('hidden');
    }
  });

  // ── One-click reorder ─────────────────────────────────────────────────
  const catalog =
    (
      window as unknown as {
        __shawVariantCatalog?: Record<string, CatalogLine>;
      }
    ).__shawVariantCatalog ?? {};

  /**
   * Turn id+qty pairs into cart lines off this page's catalogue. Unknown ids
   * are skipped: the link carries quantities, the catalogue carries the rest.
   */
  const toCartLines = (reorderLines: ReorderLine[]) =>
    reorderLines
      .map(line => {
        const entry = catalog[line.variantId];
        return entry ? { entry, qty: line.qty } : null;
      })
      .filter((line): line is { entry: CatalogLine; qty: number } => !!line)
      .map(({ entry, qty }) => ({
        productId: entry.productId,
        variantId: entry.variantId,
        title: entry.title,
        variantName: entry.variantName,
        hex: entry.hex,
        image: entry.image,
        sku: entry.sku,
        unit: entry.unit,
        tiers: entry.tiers,
        href: entry.href,
        qty,
      }));

  /**
   * Rebuild the basket as the order described, in one write.
   *
   * A reorder is a whole order, not an addition to one, so it replaces the
   * cart rather than accumulating onto whatever the browser was already
   * holding. Returns how many lines landed.
   */
  const rebuildCart = (reorderLines: ReorderLine[]): number => {
    const cartLines = toCartLines(reorderLines);
    if (!cartLines.length) return 0;
    replaceItems(cartLines);
    return cartLines.length;
  };

  /*
   * A `?reorder=` link rebuilds the basket on arrival, then removes itself
   * from the address bar so a reload does not replay it.
   */
  const params = new URLSearchParams(location.search);
  const requested = parseReorder(params.get('reorder'));
  if (requested.length) {
    const had = getItems().length;
    const added = rebuildCart(requested);
    params.delete('reorder');
    const query = params.toString();
    history.replaceState(
      {},
      '',
      location.pathname + (query ? `?${query}` : '')
    );
    if (added && note) {
      // Say so when the link displaced something, rather than letting a
      // shopper discover the difference at checkout.
      note.textContent = had
        ? 'Your cart has been rebuilt from this reorder link, replacing what was in it.'
        : 'Your reorder is in the cart.';
      note.classList.remove('hidden');
    }
  }

  /*
   * Empty cart, remembered order: offer to rebuild it. The button lives in
   * the empty state, so it disappears with that state the moment lines land.
   */
  const lastOrder = loadLastOrder().filter(line => catalog[line.variantId]);
  const reorderBtn = document.getElementById('page-cart-reorder');
  if (lastOrder.length && reorderBtn) {
    reorderBtn.classList.remove('hidden');
    reorderBtn.classList.add('inline-flex');
    reorderBtn.addEventListener('click', () => rebuildCart(lastOrder));
  }
</script>
