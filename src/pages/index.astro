---
import { getCollection } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import TrustStrip from '@components/sections/landing/TrustStrip.astro';
import MarqueeBand from '@components/sections/landing/MarqueeBand.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import VestCrossSell from '@components/sections/landing/VestCrossSell.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import ProductCard from '@components/ui/cards/ProductCard.astro';
import SectionHeading from '@components/ui/blocks/SectionHeading.astro';
import faqs from '@data/faqs.json';
import { SEO, SITE } from '@data/constants';

const products = await getCollection('products');
const zipTie = products.find(p => p.data.category === 'zip-ties')!;
const vest = products.find(p => p.data.category === 'vests')!;

const structuredData = {
  ...SEO.structuredData,
  '@type': 'WebSite',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/products?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<MainLayout
  title={`${SITE.title} | ${SITE.tagline}`}
  structuredData={structuredData}
  fullWidth
>
  <HeroSection />
  <TrustStrip />

  <div class="mx-auto max-w-(--breakpoint-2xl) px-4 sm:px-6 lg:px-8">
    <section class="py-16 lg:py-20">
      <SectionHeading
        title="Top Selling Safety Ties"
        subTitle="One tie, four high-visibility colors. Same 75-lb tensile strength, same UL 21S listing, same next-day dispatch."
      />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          zipTie.data.variants.map(variant => (
            <ProductCard product={zipTie} variantId={variant.id} />
          ))
        }
      </div>
    </section>
  </div>

  <FeaturesGeneral product={zipTie} />
  <MarqueeBand />

  <div class="mx-auto max-w-(--breakpoint-2xl) px-4 sm:px-6 lg:px-8">
    <PricingSection />
    <VestCrossSell product={vest} />
    <FAQ title="Frequently Asked <br />Questions" faqs={faqs} />
    <div class="pb-20">
      <HeroSectionAlt />
    </div>
  </div>
</MainLayout>
