---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

/**
 * Placeholder privacy policy. Scaffolding for the draft, NOT reviewed legal
 * copy — replace before collecting real customer data.
 */
const sections = [
  {
    title: 'What We Collect',
    body: 'When you place an order we collect the name, company, email, phone number, and shipping address you provide. Payment card details are handled entirely by our payment processor and never reach our servers.',
  },
  {
    title: 'Your Cart',
    body: 'Your cart is stored locally in your own browser so it survives a reload. It is not transmitted to us until you begin checkout, and clearing your browser storage removes it entirely.',
  },
  {
    title: 'How We Use It',
    body: 'We use your information to process, fulfil, and support your order, and to respond to quote requests. We do not sell customer information, and we do not send marketing email unless you ask us to.',
  },
  {
    title: 'Sharing',
    body: 'We share only what is necessary with our payment processor and shipping carriers to complete your order, and with authorities where the law requires it.',
  },
  {
    title: 'Retention',
    body: 'Order records are retained as long as needed for warranty, accounting, and tax obligations. You may request a copy or deletion of your information at any time.',
  },
];
---

<MainLayout
  title={`Privacy Policy | ${SITE.title}`}
  customDescription="How Shaw Safety handles customer information."
>
  <section class="mx-auto max-w-3xl py-14 lg:py-20">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
      Privacy Policy
    </h1>
    <p class="mt-3 text-sm text-neutral-500">
      Draft policy. This is placeholder text pending legal review.
    </p>

    <div class="mt-10 space-y-9">
      {
        sections.map(section => (
          <section>
            <h2 class="text-lg font-bold text-neutral-900">{section.title}</h2>
            <p class="mt-2 leading-relaxed text-neutral-600">{section.body}</p>
          </section>
        ))
      }

      <section>
        <h2 class="text-lg font-bold text-neutral-900">Contact</h2>
        <p class="mt-2 leading-relaxed text-neutral-600">
          Privacy requests can be sent to{' '}
          <a
            href="mailto:sales@shawsafety.com"
            class="text-maroon-700 font-semibold underline underline-offset-4"
            >sales@shawsafety.com</a
          >.
        </p>
      </section>
    </div>
  </section>
</MainLayout>
