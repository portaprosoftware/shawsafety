---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
---

<MainLayout title={`Page Not Found | ${SITE.title}`}>
  <section
    class="flex min-h-[60svh] items-center justify-center py-20 text-center"
  >
    <div class="mx-auto max-w-lg">
      <p class="text-maroon-700 text-7xl font-extrabold lg:text-9xl">404</p>
      <h1
        class="mt-4 text-3xl font-bold tracking-tight text-balance text-neutral-900 md:text-4xl"
      >
        This one came loose.
      </h1>
      <p class="mt-3 text-lg text-pretty text-neutral-600">
        The page you were after isn't here. Everything we stock is two clicks
        away.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="bg-maroon-700 hover:bg-maroon-800 focus-visible:ring-maroon-700 inline-flex items-center rounded-lg px-6 py-3 text-sm font-bold text-white transition focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2"
        >
          Go Home
        </a>
        <a
          href="/products"
          class="inline-flex items-center rounded-lg border border-neutral-300 px-6 py-3 text-sm font-bold text-neutral-800 transition hover:border-neutral-500"
        >
          Browse Products
        </a>
      </div>
    </div>
  </section>
</MainLayout>
