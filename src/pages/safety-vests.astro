---
import { getCollection } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import ProductCard from '@components/ui/cards/ProductCard.astro';
import SpecModal from '@components/ui/blocks/SpecModal.astro';
import SectionHeading from '@components/ui/blocks/SectionHeading.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { SITE } from '@data/constants';

const products = await getCollection('products');
const vests = products.filter(p => p.data.category === 'vests');

const description =
  'ANSI/ISEA 107 Class 2 hi-vis safety vests with 2-inch reflective banding and 5-point breakaway construction. Sold in 10-packs with volume pricing.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/safety-vests`,
  url: `${SITE.url}/safety-vests`,
  name: `Safety Vests | ${SITE.title}`,
  description,
  inLanguage: 'en-US',
};

const classes = [
  {
    title: 'Class 2, Type R',
    body: 'Certified for roadway, rail yard, and dock environments where traffic exceeds 25 mph — the rating most intermodal work requires.',
  },
  {
    title: '2-Inch Reflective Banding',
    body: 'Silver retroreflective tape across the torso and over both shoulders gives a full 360 degrees of return under headlights.',
  },
  {
    title: '5-Point Breakaway',
    body: 'Releases at both shoulders and both sides plus the front closure if the vest catches on moving equipment.',
  },
  {
    title: 'Crew-Sized Packs',
    body: 'Ten vests to a pack so a yard can outfit a shift in a single line item. Mixed sizing available on bulk orders.',
  },
];
---

<MainLayout
  title={`Safety Vests | ${SITE.title}`}
  customDescription={description}
  structuredData={structuredData}
>
  <section class="py-14 lg:py-20">
    <SectionHeading
      title="Hi-Vis Safety Vests"
      subTitle="The same approach we take to seals, applied to apparel: one specification that covers the work, sold in crew-sized packs, priced without a purchase order."
    />
  </section>

  <section class="pb-16">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        vests.flatMap(product =>
          product.data.variants.map(variant => (
            <ProductCard product={product} variantId={variant.id} />
          ))
        )
      }
    </div>
  </section>

  <section class="border-t border-neutral-200 py-16">
    <h2 class="text-2xl font-bold tracking-tight text-neutral-900">
      What Class 2 Actually Means
    </h2>
    <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {
        classes.map(item => (
          <div class="flex gap-3.5">
            <Icon
              name="shieldCheck"
              class="text-maroon-700 mt-0.5 h-6 w-6 shrink-0"
            />
            <div>
              <h3 class="text-sm font-bold tracking-wide text-neutral-900 uppercase">
                {item.title}
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-neutral-600">
                {item.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <div class="pb-20">
    <HeroSectionAlt
      title="Need Mixed Sizing Or Your Logo On The Back?"
      subTitle="Send a bulk quote request with your size breakdown or artwork and we will confirm pricing and lead time within one business day."
      ctaLabel="Request a Bulk Quote"
      ctaHref="/wholesale#quote"
    />
  </div>

  <SpecModal />
</MainLayout>
