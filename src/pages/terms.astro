---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

/**
 * Placeholder terms. This is boilerplate scaffolding for the draft, NOT
 * reviewed legal copy, have counsel replace it before the store takes real
 * orders.
 */
const sections = [
  {
    title: 'Orders and Acceptance',
    body: 'Placing an order constitutes an offer to purchase. An order is accepted when we confirm it by email and dispatch the goods. We may decline or cancel any order, including where a product is mispriced or out of stock, and will refund any amount already charged.',
  },
  {
    title: 'Pricing',
    body: 'Prices are shown in U.S. dollars and exclude applicable taxes and, where noted, freight. Volume tiers are applied automatically based on the quantity in your order. Published prices may change at any time, but the price confirmed at checkout governs that order.',
  },
  {
    title: 'Shipping',
    body: 'Orders placed before 5pm ET on a business day are dispatched the next business day, subject to stock. Delivery estimates are estimates and are not guaranteed. Risk of loss passes on delivery to the carrier.',
  },
  {
    title: 'Returns',
    body: 'Unopened packs may be returned within 30 days of delivery for a full refund of the purchase price. Return shipping is the buyer’s responsibility except where the goods are defective or were shipped in error.',
  },
  {
    title: 'Product Specifications and Compliance',
    body: 'Published specifications, listings, and ratings are provided by our manufacturers and are believed accurate. It remains the buyer’s responsibility to confirm that a product meets the requirements of their operation, terminal, or jurisdiction before use.',
  },
  {
    title: 'Limitation of Liability',
    body: 'To the maximum extent permitted by law, our liability arising from any order is limited to the amount paid for the goods giving rise to the claim. We are not liable for indirect, incidental, or consequential loss.',
  },
];
---

<MainLayout
  title={`Terms of Service | ${SITE.title}`}
  customDescription="Terms of service for purchases from Shaw Safety."
>
  <section class="mx-auto max-w-3xl py-14 lg:py-20">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
      Terms of Service
    </h1>
    <p class="mt-3 text-sm text-neutral-500">
      Draft terms. These are placeholder terms pending legal review and do not
      yet constitute a binding agreement.
    </p>

    <div class="mt-10 space-y-9">
      {
        sections.map(section => (
          <section>
            <h2 class="text-lg font-bold text-neutral-900">{section.title}</h2>
            <p class="mt-2 leading-relaxed text-neutral-600">{section.body}</p>
          </section>
        ))
      }

      <section>
        <h2 class="text-lg font-bold text-neutral-900">Contact</h2>
        <p class="mt-2 leading-relaxed text-neutral-600">
          Questions about these terms can be sent to{' '}
          <a
            href="mailto:sales@shawsafety.com"
            class="text-maroon-700 font-semibold underline underline-offset-4"
            >sales@shawsafety.com</a
          >.
        </p>
      </section>
    </div>
  </section>
</MainLayout>
