---
import MainLayout from '@/layouts/MainLayout.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { SITE } from '@data/constants';
---

<MainLayout
  title={`Order Confirmed | ${SITE.title}`}
  customDescription="Your Shaw Safety order is confirmed."
>
  <section
    class="flex min-h-[60svh] items-center justify-center py-20 text-center"
  >
    <div class="mx-auto max-w-lg">
      <Icon name="checkCircle" class="text-maroon-700 mx-auto h-14 w-14" />

      <h1
        class="mt-6 text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl"
      >
        Order confirmed
      </h1>
      <p class="mt-3 text-lg text-pretty text-neutral-600">
        Thanks. We have got it. A receipt is on its way to your email, and your
        order ships the next business day.
      </p>

      <p class="mt-4 text-sm text-neutral-500">
        Questions about this order? Call
        <a
          href="tel:+18005550117"
          class="text-maroon-700 font-semibold hover:underline"
          >(800) 555-0117</a
        >
        or email
        <a
          href="mailto:sales@shawsafety.com"
          class="text-maroon-700 font-semibold hover:underline"
          >sales@shawsafety.com</a
        >.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/products"
          class="bg-maroon-700 hover:bg-maroon-800 focus-visible:ring-maroon-700 inline-flex items-center rounded-lg px-6 py-3 text-sm font-bold text-white transition focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2"
        >
          Keep Shopping
        </a>
        <a
          href="/"
          class="inline-flex items-center rounded-lg border border-neutral-300 px-6 py-3 text-sm font-bold text-neutral-800 transition hover:border-neutral-500"
        >
          Back Home
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import { clear } from '@scripts/cart';

  /*
   * Emptying the basket happens here rather than at redirect time: a shopper
   * who reaches Stripe and then backs out must still have their cart. Landing
   * on this page is the first point at which the order is actually placed.
   */
  clear();
</script>
