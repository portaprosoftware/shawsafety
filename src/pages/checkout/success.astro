---
import Stripe from 'stripe';
import MainLayout from '@/layouts/MainLayout.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { SITE } from '@data/constants';
import { readEnv } from '@utils/env';
import { getVariantCatalog } from '@utils/variantCatalog';
import { parseReorder, type ReorderLine } from '@scripts/reorder';

/*
 * Rendered per request: the order is confirmed with Stripe here, server-side,
 * before the page believes in it. Landing on this URL is not payment, and the
 * browser's own idea of what was in the basket is not evidence of one.
 */
export const prerender = false;

/**
 * Labels for the reorder summary, keyed by variant id. Only names ride to the
 * client; the reorder link itself carries ids and quantities and nothing else.
 */
const labels = Object.fromEntries(
  (await getVariantCatalog()).map(line => [
    line.variantId,
    `${line.shortTitle}, ${line.variantName}`,
  ])
);

/*
 * Confirm the session Stripe redirected here with, and take the order lines
 * off it. The metadata was written by our own checkout endpoint from the
 * lines it validated, so it describes what was actually bought.
 *
 * `no_payment_required` is a paid order too: promotion codes are enabled, and
 * one that covers the whole total settles the session without a charge.
 */
const sessionId = Astro.url.searchParams.get('session_id');
const secretKey = readEnv('STRIPE_SECRET_KEY');
let confirmed = false;
let orderLines: ReorderLine[] = [];

if (sessionId && /^cs_[A-Za-z0-9_-]+$/.test(sessionId) && secretKey) {
  try {
    const session = await new Stripe(secretKey).checkout.sessions.retrieve(
      sessionId
    );
    confirmed =
      session.status === 'complete' &&
      (session.payment_status === 'paid' ||
        session.payment_status === 'no_payment_required');
    if (confirmed) orderLines = parseReorder(session.metadata?.reorder ?? null);
  } catch (error) {
    // Stripe unreachable, or an id from somewhere else. Either way this page
    // has nothing to confirm, so it says so rather than guessing.
    console.warn('[checkout/success] Could not verify the session:', error);
  }
}
---

<MainLayout
  title={confirmed
    ? `Order Confirmed | ${SITE.title}`
    : `Checkout | ${SITE.title}`}
  customDescription={confirmed
    ? 'Your Shaw Safety order is confirmed.'
    : 'Checking a Shaw Safety order.'}
>
  <section
    class="flex min-h-[60svh] items-center justify-center py-20 text-center"
  >
    <div class="mx-auto max-w-lg">
      <Icon
        name={confirmed ? 'checkCircle' : 'clock'}
        class="text-maroon-700 mx-auto h-14 w-14"
      />

      <h1
        class="mt-6 text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl"
      >
        {confirmed ? 'Order confirmed' : 'We could not confirm this order'}
      </h1>
      <p class="mt-3 text-lg text-pretty text-neutral-600">
        {
          confirmed
            ? 'Thanks. We have got it. A receipt is on its way to your email, and your order ships the next business day.'
            : 'This page could not check the order with our payment provider, so nothing here is confirmed and your cart has been left as it was. If you were charged, a receipt is in your email and the order is safe with us.'
        }
      </p>

      {
        /*
        One-click reorder. Most of these orders are monthly restocks, so the
        confirmation is the right moment to hand over a link that rebuilds
        this exact basket. Hidden until the script confirms there is a
        remembered order to link to.
      */
      }
      <div
        id="reorder-block"
        class="mt-8 hidden rounded-2xl border border-neutral-200 bg-neutral-50 p-6 text-left"
      >
        <h2 class="flex items-center gap-2 text-sm font-bold text-neutral-900">
          <Icon name="refresh" class="text-maroon-700 h-4 w-4 shrink-0" />
          Ordering this again next month?
        </h2>
        <p class="mt-1.5 text-sm text-neutral-600">
          This link rebuilds this exact order in one click. Keep it wherever
          your reorders live, or just come back here.
        </p>
        <ul id="reorder-items" class="mt-3 space-y-1 text-sm text-neutral-700">
        </ul>
        <div class="mt-4 flex flex-wrap gap-2.5">
          <a
            id="reorder-link"
            href="/cart"
            class="bg-maroon-700 hover:bg-maroon-800 focus-visible:ring-maroon-700 inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-bold text-white transition focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2"
          >
            <Icon name="cart" class="h-4 w-4" />
            Reorder now
          </a>
          <button
            type="button"
            id="reorder-copy"
            class="inline-flex items-center gap-2 rounded-lg border border-neutral-300 px-4 py-2.5 text-sm font-bold text-neutral-800 transition hover:border-neutral-500"
          >
            Copy reorder link
          </button>
        </div>
      </div>

      <p class="mt-4 text-sm text-neutral-500">
        Questions about this order? Call
        <a
          href="tel:+18005550117"
          class="text-maroon-700 font-semibold hover:underline"
          >(800) 555-0117</a
        >
        or email
        <a
          href="mailto:sales@shawsafety.com"
          class="text-maroon-700 font-semibold hover:underline"
          >sales@shawsafety.com</a
        >.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/products"
          class="bg-maroon-700 hover:bg-maroon-800 focus-visible:ring-maroon-700 inline-flex items-center rounded-lg px-6 py-3 text-sm font-bold text-white transition focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2"
        >
          Keep Shopping
        </a>
        <a
          href="/"
          class="inline-flex items-center rounded-lg border border-neutral-300 px-6 py-3 text-sm font-bold text-neutral-800 transition hover:border-neutral-500"
        >
          Back Home
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<script is:inline define:vars={{ labels, confirmed, orderLines }}>
  window.__shawVariantLabels = labels;
  window.__shawConfirmedOrder = { confirmed, lines: orderLines };
</script>

<script>
  import { clear } from '@scripts/cart';
  import {
    promotePendingOrder,
    rememberOrder,
    reorderPath,
    type ReorderLine,
  } from '@scripts/reorder';

  const labels =
    (window as unknown as { __shawVariantLabels?: Record<string, string> })
      .__shawVariantLabels ?? {};
  const paid = (
    window as unknown as {
      __shawConfirmedOrder?: { confirmed: boolean; lines: ReorderLine[] };
    }
  ).__shawConfirmedOrder ?? { confirmed: false, lines: [] };

  /*
   * Everything below hangs off the server having confirmed the session as
   * paid. Emptying the basket happens here rather than at redirect time, a
   * shopper who reaches Stripe and then backs out must still have their cart,
   * but an unconfirmed visit must not empty it either.
   *
   * The remembered order comes from the session's own metadata. The pending
   * snapshot is the fallback for orders too long for Stripe to carry, and it
   * is only trusted now that the payment behind it is established.
   */
  let order: ReorderLine[] = [];
  if (paid.confirmed) {
    clear();
    order = paid.lines.length
      ? rememberOrder(paid.lines)
      : promotePendingOrder();
  }
  const block = document.getElementById('reorder-block');
  const list = document.getElementById('reorder-items');
  const link = document.getElementById(
    'reorder-link'
  ) as HTMLAnchorElement | null;
  const copy = document.getElementById(
    'reorder-copy'
  ) as HTMLButtonElement | null;

  // Only lines the catalogue still recognises are worth offering back.
  const known = order.filter(line => labels[line.variantId]);

  if (known.length && block && list && link) {
    const path = reorderPath(known);
    link.href = path;
    list.innerHTML = known
      .map(
        line =>
          `<li>${line.qty.toLocaleString('en-US')} &times; ${labels[line.variantId]}</li>`
      )
      .join('');
    block.classList.remove('hidden');

    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(
          new URL(path, location.origin).toString()
        );
        copy.textContent = 'Copied';
      } catch {
        // Clipboard can be denied; the link itself still works.
        copy.textContent = 'Copy failed, use the link';
      }
      window.setTimeout(() => {
        copy.textContent = 'Copy reorder link';
      }, 2000);
    });
  }
</script>
