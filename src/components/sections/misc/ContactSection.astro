---
import Icon from '@components/ui/icons/Icon.astro';
import VoiceInput from '@components/ui/blocks/VoiceInput.astro';

const contactMethods = [
  {
    icon: 'phone',
    label: 'Sales & Orders',
    value: '(800) 555-0117',
    href: 'tel:+18005550117',
    note: 'Mon–Fri, 7am–6pm CT',
  },
  {
    icon: 'mail',
    label: 'Email',
    value: 'sales@shawsafety.com',
    href: 'mailto:sales@shawsafety.com',
    note: 'Replies within one business day',
  },
  {
    icon: 'truck',
    label: 'Shipping',
    value: 'Order by 5pm, ships next business day',
    href: null,
    note: 'Free U.S. shipping on retail orders',
  },
];
---

<section class="py-14 lg:py-20">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <h1
        class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl"
      >
        Talk To Someone Who Stocks It
      </h1>
      <p class="mt-4 text-neutral-600">
        Questions about a seal specification, a mixed-color bulk order, or a
        printed tie? Send the details and we will come back with pricing and a
        lead time — not a discovery call.
      </p>

      <dl class="mt-10 space-y-6">
        {
          contactMethods.map(method => (
            <div class="flex gap-4">
              <Icon
                name={method.icon}
                class="text-maroon-700 mt-0.5 h-7 w-7 shrink-0"
              />
              <div>
                <dt class="text-sm font-bold tracking-wide text-neutral-900 uppercase">
                  {method.label}
                </dt>
                <dd class="mt-0.5 text-neutral-800">
                  {method.href ? (
                    <a
                      href={method.href}
                      class="hover:text-maroon-700 font-semibold transition"
                    >
                      {method.value}
                    </a>
                  ) : (
                    <span class="font-semibold">{method.value}</span>
                  )}
                </dd>
                <dd class="mt-0.5 text-sm text-neutral-500">{method.note}</dd>
              </div>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-6 sm:p-8">
      <h2 class="text-xl font-bold text-neutral-900">Send us a message</h2>

      <form
        id="contact-form"
        class="mt-6 space-y-4"
        method="post"
        action="/api/contact"
        novalidate
      >
        <input type="hidden" name="formType" value="contact" />
        {/* Honeypot: hidden from people, irresistible to bots. */}
        <div class="hidden" aria-hidden="true">
          <label for="contact-website">Leave this field empty</label>
          <input
            id="contact-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label
              for="contact-name"
              class="block text-sm font-medium text-neutral-700">Name</label
            >
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              class="focus:border-maroon-700 focus:ring-maroon-700 mt-1.5 w-full rounded-lg border-neutral-300 text-sm"
            />
          </div>
          <div>
            <label
              for="contact-company"
              class="block text-sm font-medium text-neutral-700">Company</label
            >
            <input
              id="contact-company"
              name="company"
              type="text"
              class="focus:border-maroon-700 focus:ring-maroon-700 mt-1.5 w-full rounded-lg border-neutral-300 text-sm"
            />
          </div>
        </div>

        <div>
          <label
            for="contact-email"
            class="block text-sm font-medium text-neutral-700">Email</label
          >
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            class="focus:border-maroon-700 focus:ring-maroon-700 mt-1.5 w-full rounded-lg border-neutral-300 text-sm"
          />
        </div>

        <div>
          <label
            for="contact-message"
            class="block text-sm font-medium text-neutral-700">Message</label
          >
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            class="focus:border-maroon-700 focus:ring-maroon-700 mt-1.5 w-full rounded-lg border-neutral-300 text-sm"
          ></textarea>
        </div>

        <button
          type="submit"
          id="contact-submit"
          class="bg-maroon-700 hover:bg-maroon-800 focus-visible:ring-maroon-700 w-full rounded-lg px-5 py-3 text-sm font-bold text-white transition focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-60"
        >
          Send Message
        </button>

        <p
          id="contact-status"
          class="bg-maroon-50 text-maroon-900 hidden rounded-lg px-3.5 py-2.5 text-sm font-medium"
          role="status"
          aria-live="polite"
        >
        </p>
      </form>
    </div>
  </div>
</section>

<VoiceInput />

<script>
  import { attachFormHandler } from '@scripts/formSubmit';

  attachFormHandler({
    formId: 'contact-form',
    statusId: 'contact-status',
    submitId: 'contact-submit',
    idleLabel: 'Send Message',
  });
</script>
