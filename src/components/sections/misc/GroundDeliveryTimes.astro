---
/**
 * Ground transit-time map.
 *
 * Appears above the footer on the landing page and every product page, where
 * "when will it get here?" is the last question before checkout.
 *
 * The map is globbed rather than imported so a missing file cannot break the
 * build — the same reasoning as the hero photo and the product shots. With no
 * file present the section renders the legend alone, which still answers the
 * question in text.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const matches = import.meta.glob<{ default: ImageMetadata }>(
  '/src/images/Shipping.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);
const source = Object.values(matches)[0]?.default;

/*
 * Served at 2000px into a ~1100px box. The source is 5000px wide and the state
 * labels are small, so a 1x render turns the map to mush on a retina screen.
 */
const map = source ? await getImage({ src: source, width: 2000 }) : null;

/*
 * Swatch colours sampled from the legend baked into the map, so the text key
 * and the artwork cannot drift apart. Deliberately raw hex rather than theme
 * tokens: these are the map's colours, not the brand's.
 */
const bands = [
  { hex: '#2e7f2e', day: '1', label: '1 day' },
  { hex: '#64b964', day: '2', label: '2 days' },
  { hex: '#ffd633', day: '3', label: '3 days' },
  { hex: '#f07800', day: '4', label: '4 days' },
  { hex: '#c72929', day: '5', label: '5 days' },
];
---

<section class="border-t border-neutral-200 py-16 lg:py-20">
  <div class="mx-auto max-w-3xl text-center">
    <span
      class="bg-maroon-700 mx-auto block h-1 w-12 rounded-full"
      aria-hidden="true"></span>
    <h2
      class="mt-5 text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl"
    >
      Ground Delivery Times
    </h2>
    {
      /*
      The cutoff is stated once in src/data_files/faqs.json and repeated on the
      product pages; it is restated here rather than left implicit because
      transit time alone does not answer "when will it arrive".
    */
    }
    <p class="mt-4 text-base text-neutral-600">
      Business days in transit once your order leaves our dock. Orders placed
      before 5pm ET ship the next business day.
    </p>
  </div>

  {
    /*
      The key is real text: at phone width the map's own legend is unreadable.

      Below sm the word "days" is said once, up front, and each band shows only
      its number — five "N days" pairs are wide enough that the narrowest phones
      wrap the last one onto a row by itself, which reads as an orphan rather
      than a key. From sm up the numbers give way to the full labels and the
      "Days:" lead-in disappears, so desktop is untouched.

      The visible text is aria-hidden and each band carries its full label as
      screen-reader text, so the shorthand never reaches assistive tech.
    */
  }
  <ul
    class="mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-2.5 sm:gap-x-5"
    aria-label="Transit time key"
  >
    <li
      class="text-sm font-medium text-neutral-700 sm:hidden"
      aria-hidden="true"
    >
      Days:
    </li>
    {
      bands.map(band => (
        <li class="inline-flex items-center gap-1.5 sm:gap-2">
          <span
            class="h-3.5 w-3.5 rounded-sm border border-neutral-400/60"
            style={`background:${band.hex}`}
            aria-hidden="true"
          />
          <span class="sr-only">{band.label}</span>
          <span
            class="text-sm font-medium text-neutral-700 sm:hidden"
            aria-hidden="true"
          >
            {band.day}
          </span>
          <span
            class="hidden text-sm font-medium text-neutral-700 sm:inline"
            aria-hidden="true"
          >
            {band.label}
          </span>
        </li>
      ))
    }
  </ul>

  {
    map && (
      <figure class="mt-10">
        <div class="mx-auto max-w-5xl">
          <img
            src={map.src}
            alt="Map of the contiguous United States, Alaska and Hawaii, shaded by ground transit time. The Ohio Valley and Northeast are one day; the upper Midwest, Southeast and New England are two; the Plains, Texas and Florida are three; the Southwest is four; and the Pacific Northwest, Alaska and Hawaii are five."
            width="2000"
            height="1400"
            loading="lazy"
            decoding="async"
            class="h-auto w-full rounded-xl"
          />
        </div>
      </figure>
    )
  }

  <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-neutral-500">
    Transit times are carrier estimates and exclude weekends and holidays. If
    you need a guaranteed delivery date, get in touch and we will confirm before
    you order.
  </p>

  <div class="mt-5 flex justify-center">
    <a
      href="/contact"
      class="focus-visible:ring-maroon-700 inline-flex items-center rounded-lg border border-neutral-300 px-6 py-3 text-sm font-bold text-neutral-800 transition hover:border-neutral-500 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2"
    >
      Get in Touch
    </a>
  </div>
</section>
