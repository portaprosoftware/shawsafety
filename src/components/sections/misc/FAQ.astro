---
import AccordionItem from '@components/ui/blocks/AccordionItem.astro';

interface Faq {
  question: string;
  answer: string;
}

interface FaqGroup {
  subTitle?: string;
  faqs: Faq[];
}

interface Props {
  title: string;
  faqs: FaqGroup;
}

const { title, faqs } = Astro.props;
---

<section class="py-16 lg:py-20">
  <div class="grid gap-10 md:grid-cols-5">
    <div class="md:col-span-2">
      <div class="max-w-xs md:sticky md:top-32">
        <h2
          class="text-3xl font-bold tracking-tight text-neutral-900 md:text-4xl"
        >
          <Fragment set:html={title} />
        </h2>
        <p class="mt-3 text-neutral-600">{faqs.subTitle}</p>
      </div>
    </div>
    <div class="md:col-span-3">
      <div class="hs-accordion-group divide-y divide-neutral-200">
        {
          faqs.faqs.map((faq, i) => (
            <AccordionItem
              {...faq}
              id={`faq-heading-${i + 1}`}
              collapseId={`faq-collapse-${i + 1}`}
              first={i === 0}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
