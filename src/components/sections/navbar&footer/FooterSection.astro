---
import BrandLogo from '@components/BrandLogo.astro';
import Icon from '@components/ui/icons/Icon.astro';
import navigation from '@utils/navigation';
import { SITE } from '@data/constants';
---

<footer class="mt-24 w-full border-t border-neutral-200 bg-neutral-50">
  <div
    class="mx-auto w-full max-w-(--breakpoint-2xl) px-4 py-14 sm:px-6 lg:px-8"
  >
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <BrandLogo class="text-maroon-700 h-8 w-auto" />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-neutral-600">
          {SITE.description_short}
        </p>
        <div
          class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-neutral-600"
        >
          <a
            href="tel:+18005550117"
            class="hover:text-maroon-700 inline-flex items-center gap-2 font-medium transition"
          >
            <Icon name="phone" class="h-4 w-4" />
            (800) 555-0117
          </a>
          <a
            href="mailto:sales@shawsafety.com"
            class="hover:text-maroon-700 inline-flex items-center gap-2 font-medium transition"
          >
            <Icon name="mail" class="h-4 w-4" />
            sales@shawsafety.com
          </a>
        </div>
      </div>

      {
        navigation.footerLinks.map(section => (
          <div>
            <h3 class="text-sm font-bold tracking-wide text-neutral-900 uppercase">
              {section.section}
            </h3>
            <ul class="mt-4 space-y-2.5">
              {section.links.map(link => (
                <li>
                  <a
                    href={link.url}
                    class="hover:text-maroon-700 text-sm text-neutral-600 transition"
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-neutral-200 pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm text-neutral-500">
        &copy; <span id="current-year"></span>
        {SITE.title}. All rights reserved.
      </p>
      <div class="flex items-center gap-4 text-sm text-neutral-500">
        <a href="/terms" class="hover:text-maroon-700 transition">Terms</a>
        <a href="/privacy" class="hover:text-maroon-700 transition">Privacy</a>
        <a href="/contact" class="hover:text-maroon-700 transition">Contact</a>
      </div>
    </div>
  </div>

  <script>
    const el = document.getElementById('current-year');
    if (el) el.textContent = String(new Date().getFullYear());
  </script>
</footer>
