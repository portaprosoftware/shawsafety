---
import BrandLogo from '@components/BrandLogo.astro';
import Icon from '@components/ui/icons/Icon.astro';
import navigation from '@utils/navigation';
import { SITE } from '@data/constants';
---

<footer class="mt-24 w-full border-t border-neutral-200 bg-neutral-50">
  <div
    class="mx-auto w-full max-w-(--breakpoint-2xl) px-4 py-14 sm:px-6 lg:px-8"
  >
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <BrandLogo class="text-maroon-700 h-8 w-auto" />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-neutral-600">
          {SITE.description_short}
        </p>
        <div
          class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-neutral-600"
        >
          <a
            href="tel:+18005550117"
            class="hover:text-maroon-700 inline-flex items-center gap-2 font-medium transition"
          >
            <Icon name="phone" class="h-4 w-4" />
            (800) 555-0117
          </a>
          <a
            href="mailto:sales@shawsafety.com"
            class="hover:text-maroon-700 inline-flex items-center gap-2 font-medium transition"
          >
            <Icon name="mail" class="h-4 w-4" />
            sales@shawsafety.com
          </a>
        </div>
      </div>

      {
        navigation.footerLinks.map(section => (
          <div>
            <h3 class="text-sm font-bold tracking-wide text-neutral-900 uppercase">
              {section.section}
            </h3>
            <ul class="mt-4 space-y-2.5">
              {section.links.map(link => (
                <li>
                  <a
                    href={link.url}
                    class="hover:text-maroon-700 text-sm text-neutral-600 transition"
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 border-t border-neutral-200 pt-6">
      <h3 class="text-xs font-bold tracking-wider text-neutral-500 uppercase">
        Accepted Payments
      </h3>
      <ul class="mt-3 grid w-max grid-cols-5 items-center gap-2 sm:flex sm:w-auto sm:flex-wrap" aria-label="Accepted payment methods">
        <li>
          <span class="flex h-8 w-12 items-center justify-center rounded-md bg-[#1a1f71] text-[10px] font-extrabold tracking-wider text-white italic shadow-sm" aria-label="Visa">VISA</span>
        </li>
        <li>
          <span class="relative flex h-8 w-12 items-center justify-center rounded-md bg-white shadow-sm ring-1 ring-neutral-200" aria-label="Mastercard">
            <svg viewBox="0 0 32 20" class="h-4 w-auto" aria-hidden="true">
              <circle cx="12" cy="10" r="7" fill="#EB001B" />
              <circle cx="20" cy="10" r="7" fill="#F79E1B" />
              <path d="M16 5.2a7 7 0 0 1 0 9.6 7 7 0 0 1 0-9.6z" fill="#FF5F00" />
            </svg>
          </span>
        </li>
        <li>
          <span class="flex h-8 w-12 items-center justify-center rounded-md bg-[#1F72CD] text-[9px] font-extrabold tracking-wide text-white shadow-sm" aria-label="American Express">AMEX</span>
        </li>
        <li>
          <span class="relative flex h-8 w-12 items-center justify-center overflow-hidden rounded-md bg-white text-[8px] font-extrabold tracking-wide text-neutral-800 shadow-sm ring-1 ring-neutral-200" aria-label="Discover">
            <span class="relative z-10">DISC</span>
            <span class="absolute right-1 top-1/2 h-4 w-4 -translate-y-1/2 rounded-full bg-[#FF6000]"></span>
          </span>
        </li>
        <li>
          <span class="flex h-8 w-12 items-center justify-center rounded-md bg-white text-[9px] font-bold text-[#003087] shadow-sm ring-1 ring-neutral-200" aria-label="PayPal">
            Pay<span class="text-[#009cde]">Pal</span>
          </span>
        </li>
        <li>
          <span class="flex h-8 w-12 items-center justify-center gap-0.5 rounded-md bg-black text-[10px] font-semibold text-white shadow-sm" aria-label="Apple Pay">
            <svg viewBox="0 0 16 16" class="h-3 w-3" fill="currentColor" aria-hidden="true">
              <path d="M13.5 12.2c-.3.7-.5 1-.9 1.6-.6.8-1.4 1.8-2.4 1.8-.9 0-1.1-.6-2.3-.6-1.2 0-1.5.6-2.3.6-1 0-1.8-.9-2.3-1.7C1.7 11.5 1.6 8.7 3 7.2c.9-1 2.4-1.6 3.6-1.6 1.3 0 2.1.7 3.1.7 1 0 1.6-.7 3.1-.7 1.1 0 2.2.6 3 1.6-2.6 1.4-2.2 5.1-.3 5zM10.4 4.4c.6-.7.9-1.6.8-2.6-.8.1-1.7.6-2.3 1.2-.5.6-.9 1.5-.8 2.4.9.1 1.7-.4 2.3-1z"/>
            </svg>
            Pay
          </span>
        </li>
        <li>
          <span class="flex h-8 w-12 items-center justify-center gap-1 rounded-md bg-[#00D66F] text-[10px] font-bold text-black shadow-sm" aria-label="Link by Stripe">
            <svg viewBox="0 0 16 16" class="h-3 w-3" fill="currentColor" aria-hidden="true">
              <path d="M5 3l6 5-6 5V3z"/>
            </svg>
            link
          </span>
        </li>
        <li>
          <span class="flex h-8 w-12 items-center justify-center rounded-md bg-white text-[9px] font-extrabold tracking-wide text-[#2AA9E0] shadow-sm ring-1 ring-neutral-200" aria-label="ACH bank transfer">ACH</span>
        </li>
        <li>
          <span class="flex h-8 w-12 items-center justify-center gap-0.5 rounded-md bg-white text-[10px] font-medium text-neutral-700 shadow-sm ring-1 ring-neutral-200" aria-label="Google Pay">
            <svg viewBox="0 0 24 24" class="h-3 w-3" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.56-2.76c-.99.66-2.25 1.06-3.72 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.11a6.6 6.6 0 0 1 0-4.22V7.05H2.18a11 11 0 0 0 0 9.9l3.66-2.84z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a11 11 0 0 0-9.82 6.05l3.66 2.84C6.71 7.29 9.14 5.38 12 5.38z"/>
            </svg>
            Pay
          </span>
        </li>
      </ul>
    </div>

    <div
      class="mt-8 flex flex-col gap-4 border-t border-neutral-200 pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm text-neutral-500">
        &copy; <span id="current-year"></span>{' '}{SITE.title}. All rights
        reserved.
      </p>
      <div class="flex items-center gap-4 text-sm text-neutral-500">
        <a href="/terms" class="hover:text-maroon-700 transition">Terms</a>
        <a href="/privacy" class="hover:text-maroon-700 transition">Privacy</a>
        <a href="/contact" class="hover:text-maroon-700 transition">Contact</a>
      </div>
    </div>
  </div>

  <script>
    const el = document.getElementById('current-year');
    if (el) el.textContent = String(new Date().getFullYear());
  </script>
</footer>
