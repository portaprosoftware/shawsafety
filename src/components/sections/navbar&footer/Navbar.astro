---
import BrandLogo from '@components/BrandLogo.astro';
import CartButton from '@components/cart/CartButton.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { getCollection } from 'astro:content';
import navigation from '@utils/navigation';

/**
 * The catalogue is tiny (a handful of SKUs), so search is a client-side
 * filter over this serialized index rather than a backend query.
 */
const products = await getCollection('products');
const searchIndex = products.flatMap(p =>
  p.data.variants.map(v => ({
    title: `${p.data.shortTitle}, ${v.name}`,
    sku: v.sku,
    href: `/products/${p.id}?color=${v.id}`,
    hex: v.hex,
  }))
);

/*
 * The shop dropdown lists a category on the left and its color swatches on the
 * right, so the picker fans out from the same product entries used above. The
 * `slug` maps a category label to its product page id.
 */
type ShopCategory = {
  key: string;
  label: string;
  slug: string;
  variants: { id: string; name: string; hex: string }[];
};
const categoryMap: Record<string, { label: string }> = {
  'zip-ties': { label: 'Safety Ties' },
  vests: { label: 'Safety Vests' },
};
const shopCategories: ShopCategory[] = products
  .filter(p => p.data.category in categoryMap)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map(p => ({
    key: p.data.category,
    label: categoryMap[p.data.category].label,
    slug: p.id,
    variants: p.data.variants.map(v => ({
      id: v.id,
      name: v.name,
      hex: v.hex,
    })),
  }));

/*
 * The phone number is duplicated in the footer; keeping the same literal here
 * avoids a shared config module for one string.
 */
const phone = { display: '(800) 555-0117', href: 'tel:+18005550117' };

/*
 * Pages build to directories, so `Astro.url.pathname` arrives as `/wholesale/`
 * while the links below are written `/wholesale`. Without trimming the trailing
 * slash the current-page comparisons never match and `aria-current` is never
 * emitted on any page.
 */
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

/*
 * The dropdown covers both product pages, so any URL beginning with `/products`
 * or the vest landing page should light up the trigger as the current section.
 */
const shopActive =
  pathname === '/safety-vests' || pathname.startsWith('/products');

// Non-shop links still render inline next to the dropdown.
const otherLinks = navigation.navBarLinks.filter(
  l => l.name === 'Wholesale'
);
---

<header
  class="border-maroon-700 border-b-2 bg-white/95 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-(--breakpoint-2xl) items-center gap-4 px-4 py-3 sm:px-6 lg:px-8"
    aria-label="Main"
  >
    <a
      href="/"
      class="text-maroon-700 hover:text-maroon-800 focus-visible:ring-maroon-700 shrink-0 transition focus:outline-hidden focus-visible:ring-2"
      aria-label="Shaw Safety home"
    >
      {
        /* The anchor is already labelled, so the logo is not described again. */
      }
      <BrandLogo class="h-7 w-auto sm:h-8" alt="" />
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      <li class="relative" id="shop-dropdown">
        <button
          type="button"
          id="shop-dropdown-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="shop-dropdown-panel"
          class:list={[
            'hover:text-maroon-700 inline-flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-semibold transition hover:bg-neutral-100',
            shopActive ? 'text-maroon-700' : 'text-neutral-700',
          ]}
        >
          Shop Safety Ties &amp; Vests
          <Icon name="chevronDown" class="h-4 w-4" />
        </button>
        <div
          id="shop-dropdown-panel"
          data-active-category={shopCategories[0]?.key}
          class="absolute top-full left-0 z-20 mt-1 hidden overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-xl"
          role="menu"
          aria-labelledby="shop-dropdown-trigger"
        >
          <div class="flex">
            <ul class="w-52 shrink-0 border-r border-neutral-200 py-2">
              {
                shopCategories.map((cat, i) => (
                  <li>
                    <button
                      type="button"
                      class:list={[
                        'shop-cat-btn flex w-full items-center justify-between gap-2 px-4 py-2.5 text-left text-sm font-semibold transition',
                        i === 0
                          ? 'bg-neutral-50 text-maroon-700'
                          : 'text-neutral-700 hover:bg-neutral-50 hover:text-maroon-700',
                      ]}
                      data-category={cat.key}
                      aria-current={i === 0 ? 'true' : undefined}
                    >
                      {cat.label}
                      <Icon name="chevronRight" class="h-4 w-4" />
                    </button>
                  </li>
                ))
              }
            </ul>
            <div class="w-72 p-4">
              {
                shopCategories.map((cat, i) => (
                  <div
                    class:list={['shop-cat-panel', i === 0 ? '' : 'hidden']}
                    data-panel={cat.key}
                  >
                    <p class="mb-3 text-xs font-semibold tracking-wide text-neutral-500 uppercase">
                      Pick a color
                    </p>
                    <ul class="grid grid-cols-1 gap-1">
                      {cat.variants.map(v => (
                        <li>
                          <a
                            href={`/products/${cat.slug}?color=${v.id}`}
                            class="hover:bg-maroon-50 flex items-center gap-3 rounded-lg px-2 py-2 text-sm text-neutral-800 transition"
                          >
                            <span
                              class="h-5 w-5 shrink-0 rounded-full border border-neutral-300"
                              style={`background:${v.hex}`}
                            />
                            <span class="font-medium">{v.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </li>
      {
        otherLinks.map(link => (
          <li>
            <a
              href={link.url}
              aria-current={pathname === link.url ? 'page' : undefined}
              class:list={[
                'hover:text-maroon-700 rounded-lg px-3 py-2 text-sm font-semibold transition hover:bg-neutral-100',
                pathname === link.url ? 'text-maroon-700' : 'text-neutral-700',
              ]}
            >
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="relative ml-auto hidden min-w-0 flex-1 md:block lg:max-w-md">
      <label for="product-search" class="sr-only">Search products</label>
      <input
        id="product-search"
        type="search"
        autocomplete="off"
        placeholder="Search products..."
        class="focus:border-maroon-700 focus:ring-maroon-700 w-full rounded-lg border border-neutral-300 bg-white py-2.5 pr-11 pl-4 text-sm text-neutral-900 placeholder:text-neutral-400 focus:ring-1"
      />
      <span
        class="bg-maroon-700 pointer-events-none absolute inset-y-0 right-0 flex w-11 items-center justify-center rounded-r-lg text-white"
      >
        <Icon name="search" class="h-4 w-4" />
      </span>
      <ul
        id="search-results"
        class="absolute top-full right-0 left-0 z-10 mt-1 hidden max-h-80 overflow-y-auto rounded-lg border border-neutral-200 bg-white py-1 shadow-xl"
      >
      </ul>
    </div>

    {
      /*
       * Phone number lives in the mobile header (centered between logo and
       * cart) and again on desktop next to the account/contact CTAs. On mobile
       * `flex-1` claims the whitespace left by removing the search bar; on
       * desktop the block sits inline. Using `absolute` centering on mobile so
       * the logo + cart cluster don't push it off-center on narrower phones.
       */
    }
    <a
      href={phone.href}
      class="text-maroon-700 hover:text-maroon-800 absolute left-1/2 -translate-x-1/2 inline-flex items-center gap-1.5 text-sm font-semibold whitespace-nowrap transition md:static md:translate-x-0"
      aria-label={`Call Shaw Safety at ${phone.display}`}
    >
      <Icon name="phone" class="h-4 w-4" />
      <span>{phone.display}</span>
    </a>

    <div class="ml-auto flex items-center gap-1 md:ml-0">
      {
        /*
         * Same destination as the footer's Contact link. This just surfaces it
         * without a scroll to the bottom of the page. Outlined rather than
         * solid so it reads as secondary to the product CTAs it sits beside.
         * Below `lg` it gives way to the entry in the mobile menu.
         */
      }
      <a
        href="https://app.portaprosoftware.com/t/shaw-safety/sign-in"
        target="_blank"
        rel="noopener noreferrer"
        class="text-maroon-700 hover:bg-maroon-700 focus-visible:ring-maroon-700 hidden shrink-0 rounded-lg px-3.5 py-2 text-sm font-semibold transition hover:text-white focus:outline-hidden focus-visible:ring-2 lg:inline-flex"
      >
        My Account
      </a>
      <a
        href="/contact"
        aria-current={pathname === '/contact' ? 'page' : undefined}
        class:list={[
          'border-maroon-700 text-maroon-700 hover:bg-maroon-700 focus-visible:ring-maroon-700 hidden shrink-0 rounded-lg border px-3.5 py-2 text-sm font-semibold transition hover:text-white focus:outline-hidden focus-visible:ring-2 lg:inline-flex',
          pathname === '/contact' ? 'bg-maroon-700 text-white' : '',
        ]}
      >
        Contact
      </a>
      <CartButton />
      <button
        type="button"
        id="mobile-menu-toggle"
        class="rounded-lg p-2 text-neutral-700 transition hover:bg-neutral-100 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-neutral-200 lg:hidden">
    <ul class="space-y-1 px-4 py-3 sm:px-6">
      <li>
        <button
          type="button"
          class="mobile-shop-toggle hover:text-maroon-700 flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100"
          aria-expanded="false"
          aria-controls="mobile-shop-panel"
        >
          Shop Safety Ties &amp; Vests
          <Icon name="chevronDown" class="h-4 w-4 mobile-shop-chevron transition" />
        </button>
        <div id="mobile-shop-panel" class="hidden pl-2">
          {
            shopCategories.map(cat => (
              <div class="mt-1">
                <p class="mt-2 px-3 text-xs font-semibold tracking-wide text-neutral-500 uppercase">
                  {cat.label}
                </p>
                <ul class="mt-1 grid grid-cols-2 gap-1">
                  {cat.variants.map(v => (
                    <li>
                      <a
                        href={`/products/${cat.slug}?color=${v.id}`}
                        class="hover:bg-maroon-50 flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-neutral-800 transition"
                      >
                        <span
                          class="h-4 w-4 shrink-0 rounded-full border border-neutral-300"
                          style={`background:${v.hex}`}
                        />
                        <span class="min-w-0 truncate">{v.name}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </li>
      {
        otherLinks.map(link => (
          <li>
            <a
              href={link.url}
              class="hover:text-maroon-700 block rounded-lg px-3 py-2.5 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100"
            >
              {link.name}
            </a>
          </li>
        ))
      }
      <li class="pt-1">
        <a
          href="https://app.portaprosoftware.com/t/shaw-safety/sign-in"
          target="_blank"
          rel="noopener noreferrer"
          class="text-maroon-700 hover:bg-maroon-700 block rounded-lg px-3 py-2.5 text-center text-sm font-semibold transition hover:text-white"
        >
          My Account
        </a>
      </li>
      <li>
        <a
          href="/contact"
          class="border-maroon-700 text-maroon-700 hover:bg-maroon-700 block rounded-lg border px-3 py-2.5 text-center text-sm font-semibold transition hover:text-white"
        >
          Contact
        </a>
      </li>
    </ul>
  </div>
</header>

<script is:inline define:vars={{ searchIndex }}>
  window.__shawSearchIndex = searchIndex;
</script>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  // Mobile shop accordion.
  const mobileShopToggle = document.querySelector<HTMLButtonElement>(
    '.mobile-shop-toggle'
  );
  const mobileShopPanel = document.getElementById('mobile-shop-panel');
  const mobileShopChevron = document.querySelector<SVGElement>(
    '.mobile-shop-chevron'
  );
  mobileShopToggle?.addEventListener('click', () => {
    const open = mobileShopPanel?.classList.toggle('hidden') === false;
    mobileShopToggle.setAttribute('aria-expanded', String(open));
    mobileShopChevron?.classList.toggle('rotate-180', open);
  });

  // Desktop shop dropdown: hover to preview, click to pin. A pinned panel
  // ignores mouseleave and stays open until the user clicks outside or hits
  // Escape, so a user who commits to the menu can move their pointer around
  // the page without the panel evaporating.
  const shopRoot = document.getElementById('shop-dropdown');
  const shopTrigger = document.getElementById('shop-dropdown-trigger');
  const shopPanel = document.getElementById('shop-dropdown-panel');
  let shopPinned = false;
  const openShop = () => {
    shopPanel?.classList.remove('hidden');
    shopTrigger?.setAttribute('aria-expanded', 'true');
  };
  const closeShop = () => {
    shopPinned = false;
    shopPanel?.classList.add('hidden');
    shopTrigger?.setAttribute('aria-expanded', 'false');
  };
  shopTrigger?.addEventListener('click', e => {
    e.stopPropagation();
    if (shopPinned) {
      closeShop();
    } else {
      shopPinned = true;
      openShop();
    }
  });
  shopRoot?.addEventListener('mouseenter', openShop);
  shopRoot?.addEventListener('mouseleave', () => {
    if (!shopPinned) closeShop();
  });
  document.addEventListener('click', e => {
    if (!shopRoot?.contains(e.target as Node)) closeShop();
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeShop();
  });

  const catButtons =
    document.querySelectorAll<HTMLButtonElement>('.shop-cat-btn');
  const catPanels =
    document.querySelectorAll<HTMLElement>('.shop-cat-panel');
  const activateCategory = (key: string) => {
    catButtons.forEach(b => {
      const active = b.dataset.category === key;
      b.classList.toggle('bg-neutral-50', active);
      b.classList.toggle('text-maroon-700', active);
      b.classList.toggle('text-neutral-700', !active);
      if (active) b.setAttribute('aria-current', 'true');
      else b.removeAttribute('aria-current');
    });
    catPanels.forEach(p => {
      p.classList.toggle('hidden', p.dataset.panel !== key);
    });
  };
  catButtons.forEach(b => {
    const key = b.dataset.category;
    if (!key) return;
    b.addEventListener('mouseenter', () => activateCategory(key));
    b.addEventListener('focus', () => activateCategory(key));
    b.addEventListener('click', ev => {
      ev.stopPropagation();
      activateCategory(key);
    });
  });

  interface SearchEntry {
    title: string;
    sku: string;
    href: string;
    hex: string;
  }

  const input = document.getElementById(
    'product-search'
  ) as HTMLInputElement | null;
  const results = document.getElementById('search-results');
  const index: SearchEntry[] =
    (window as unknown as { __shawSearchIndex?: SearchEntry[] })
      .__shawSearchIndex ?? [];

  const render = (query: string) => {
    if (!results) return;
    const q = query.trim().toLowerCase();
    if (q.length < 2) {
      results.classList.add('hidden');
      return;
    }
    const matches = index
      .filter(
        e =>
          e.title.toLowerCase().includes(q) || e.sku.toLowerCase().includes(q)
      )
      .slice(0, 8);
    results.innerHTML = matches.length
      ? matches
          .map(
            e => `
        <li>
          <a href="${e.href}" class="flex items-center gap-3 px-3 py-2.5 text-sm hover:bg-neutral-50">
            <span class="h-4 w-4 shrink-0 rounded-full border border-neutral-300" style="background:${e.hex}"></span>
            <span class="min-w-0 flex-1 truncate font-medium text-neutral-800">${e.title}</span>
            <span class="shrink-0 text-xs text-neutral-400">${e.sku}</span>
          </a>
        </li>`
          )
          .join('')
      : '<li class="px-3 py-2.5 text-sm text-neutral-500">No products match that search.</li>';
    results.classList.remove('hidden');
  };

  input?.addEventListener('input', () => render(input.value));
  input?.addEventListener('focus', () => render(input.value));
  document.addEventListener('click', e => {
    if (
      !results?.contains(e.target as Node) &&
      e.target !== input &&
      results &&
      !results.classList.contains('hidden')
    ) {
      results.classList.add('hidden');
    }
  });
</script>
