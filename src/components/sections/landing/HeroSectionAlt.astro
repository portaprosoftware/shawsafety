---
import Icon from '@components/ui/icons/Icon.astro';

interface Props {
  title?: string;
  subTitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = 'Seals Ship Within 24 Hours, Not Weeks',
  subTitle = 'Same compliance. Same visibility. Lower price. Order before 5pm and it leaves our dock the next business day.',
  ctaLabel = 'Browse All Products',
  ctaHref = '/products',
} = Astro.props;
---

<section
  class="from-brand-grad-from to-brand-grad-to relative overflow-hidden rounded-2xl bg-linear-to-tr px-6 py-16 text-center sm:px-12 lg:py-20"
>
  <div
    class="absolute inset-0 opacity-10 mix-blend-overlay"
    style="background-image:linear-gradient(to right,#fff 1px,transparent 1px),linear-gradient(to bottom,#fff 1px,transparent 1px);background-size:48px 48px"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-2xl">
    <h2
      class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
    >
      {title}
    </h2>
    <p class="mt-4 text-base text-white/85">{subTitle}</p>
    <a
      href={ctaHref}
      class="group text-maroon-900 focus-visible:ring-offset-maroon-800 mt-8 inline-flex items-center gap-2 rounded-lg bg-white px-7 py-3.5 text-sm font-bold transition hover:bg-neutral-100 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
    >
      {ctaLabel}
      <Icon
        name="arrowRight"
        class="h-4 w-4 transition group-hover:translate-x-1"
      />
    </a>
  </div>
</section>
