---
import { Image } from 'astro:assets';
import heroImage from '@images/hero-image.svg';
import Icon from '@components/ui/icons/Icon.astro';
---

<section class="relative overflow-hidden">
  <div class="relative isolate min-h-[520px] lg:min-h-[640px]">
    <Image
      id="hero-photo"
      src={heroImage}
      alt="Intermodal container on a highway at sunset"
      width={2000}
      height={1000}
      loading="eager"
      class="absolute inset-0 h-[118%] w-full object-cover"
    />

    {/* Brand scrim: keeps the headline legible over any part of the photo. */}
    <div
      class="from-maroon-950/92 via-maroon-950/55 absolute inset-0 bg-linear-to-r to-transparent"
      aria-hidden="true"
    >
    </div>

    {/* Fine engineering grid — the "futuristic" layer, kept subtle. */}
    <div
      class="absolute inset-0 opacity-[0.14] mix-blend-overlay"
      style="background-image:linear-gradient(to right,#fff 1px,transparent 1px),linear-gradient(to bottom,#fff 1px,transparent 1px);background-size:64px 64px"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative mx-auto flex min-h-[520px] max-w-(--breakpoint-2xl) flex-col justify-center px-4 py-20 sm:px-6 lg:min-h-[640px] lg:px-8"
    >
      <p
        data-rise
        class="text-xs font-bold tracking-[0.22em] text-white/80 uppercase"
      >
        Supplying Intermodal Hubs Nationwide
      </p>
      <h1
        data-rise
        class="mt-5 max-w-3xl text-4xl leading-[1.05] font-bold tracking-tight text-white sm:text-6xl lg:text-7xl"
      >
        Industrial Zip Ties<br />Securing Fleets For Less
      </h1>
      <p data-rise class="mt-6 max-w-xl text-base text-white/85 sm:text-lg">
        UL 21S listed security ties and ANSI-rated hi-vis gear, sold direct at
        wholesale pricing. Same compliance, same visibility, lower price.
      </p>
      <div data-rise class="mt-9 flex flex-wrap gap-3">
        <a
          href="/products/11-inch-zip-tie-100-pack"
          class="group bg-maroon-700 hover:bg-maroon-600 inline-flex items-center gap-2 rounded-lg px-7 py-3.5 text-sm font-bold text-white transition focus:outline-hidden focus-visible:ring-2 focus-visible:ring-white"
        >
          Shop Safety Ties
          <Icon
            name="arrowRight"
            class="h-4 w-4 transition group-hover:translate-x-1"
          />
        </a>
        <a
          href="/safety-vests"
          class="inline-flex items-center gap-2 rounded-lg border border-white/60 px-7 py-3.5 text-sm font-bold text-white transition hover:bg-white/10 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-white"
        >
          Shop Safety Vests
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    gsap.from('[data-rise]', {
      y: 26,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
      stagger: 0.09,
    });

    // Slow parallax drift on the photo. The image is rendered at 118% height
    // so there is headroom to travel without exposing an edge.
    const photo = document.getElementById('hero-photo');
    if (photo) {
      let ticking = false;
      const update = () => {
        const offset = Math.min(window.scrollY, 700) * 0.16;
        gsap.set(photo, { y: -offset });
        ticking = false;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        },
        { passive: true }
      );
    }
  }
</script>
