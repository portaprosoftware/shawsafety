---
import Icon from '@components/ui/icons/Icon.astro';

/**
 * Background video for the hero, hosted on Gumlet.
 *
 * `background=true` gives a chromeless, muted, looping player with no
 * controls. It is decoration behind the headline, not something anyone is
 * meant to interact with, which is also why the wrapper is aria-hidden.
 *
 * Adding a host here is not enough on its own: the `frame-src` directive in
 * vercel.json must allow it too, or the browser blocks the frame outright and
 * the hero silently falls back to the gradient.
 */
const VIDEO_SRC =
  'https://play.gumlet.io/embed/6a77412da219b0caeb44e90c' +
  '?background=true&autoplay=true&loop=true&disable_player_controls=true';
---

<section class="relative overflow-hidden">
  <div class="relative isolate min-h-[520px] lg:min-h-[640px]">
    {
      /* Base wash. Shows through until the video loads, and stands alone
        whenever it does not: reduced motion, no JavaScript, or a blocked frame. */
    }
    <div
      class="from-maroon-950 via-maroon-900 to-maroon-700 absolute inset-0 bg-linear-to-br"
      aria-hidden="true"
    >
    </div>

    {
      /*
      The frame is injected by the script below rather than rendered here, so
      that a visitor who has asked for reduced motion never loads it at all.
      A cross-origin player cannot be paused from this page, so declining to
      start it is the only way to honour that preference, WCAG 2.2.2 wants
      motion that runs beyond five seconds to be stoppable.

      `container-type: size` makes cqw/cqh below resolve against this box.
    */
    }
    <div
      data-hero-video-slot
      class="[container-type:size] absolute inset-0 overflow-hidden"
      aria-hidden="true"
    >
    </div>

    <template data-hero-video>
      {
        /*
        Sized to cover rather than fit. The hero is a wide, short band and the
        video is 16:9, so letting the frame fill the box would letterbox it.
        Taking the larger of "full width" and "the width a full-height 16:9
        frame needs" (and the same for height) guarantees the video overflows
        on one axis instead, the standard cover trick, done in container units
        so it follows this box rather than the viewport.
      */
      }
      <iframe
        title="Gumlet video player"
        src={VIDEO_SRC}
        loading="lazy"
        referrerpolicy="origin"
        allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen; clipboard-write;"
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 border-none"
        style="width:max(100cqw,calc(100cqh*16/9));height:max(100cqh,calc(100cqw*9/16))"
      >
      </iframe>
    </template>

    {/* Brand scrim: keeps the headline legible over any frame of the video. */}
    <div
      class="from-maroon-950/92 via-maroon-950/55 absolute inset-0 bg-linear-to-r to-transparent"
      aria-hidden="true"
    >
    </div>

    {/* Fine engineering grid, the "futuristic" layer, kept subtle. */}
    <div
      class="absolute inset-0 opacity-[0.14] mix-blend-overlay"
      style="background-image:linear-gradient(to right,#fff 1px,transparent 1px),linear-gradient(to bottom,#fff 1px,transparent 1px);background-size:64px 64px"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative mx-auto flex min-h-[520px] max-w-(--breakpoint-2xl) flex-col justify-center px-4 py-20 sm:px-6 lg:min-h-[640px] lg:px-8"
    >
      <p
        data-rise
        class="text-xs font-bold tracking-[0.22em] text-white/80 uppercase"
      >
        Supplying Intermodal Hubs Nationwide
      </p>
      <h1
        data-rise
        class="mt-5 max-w-3xl text-4xl leading-[1.05] font-bold tracking-tight text-white sm:text-6xl lg:text-7xl"
      >
        Industrial Zip Ties<br />Securing Fleets For Less
      </h1>
      <p data-rise class="mt-6 max-w-xl text-base text-white/85 sm:text-lg">
        UL 21S listed security ties and ANSI-rated hi-vis gear, sold direct at
        wholesale pricing. Same compliance, same visibility, lower price.
      </p>
      <div data-rise class="mt-9 flex flex-wrap gap-3">
        <a
          href="/products/11-inch-zip-tie-100-pack"
          class="group bg-maroon-700 hover:bg-maroon-600 inline-flex items-center gap-2 rounded-lg px-7 py-3.5 text-sm font-bold text-white transition focus:outline-hidden focus-visible:ring-2 focus-visible:ring-white"
        >
          Shop Safety Ties
          <Icon
            name="arrowRight"
            class="h-4 w-4 transition group-hover:translate-x-1"
          />
        </a>
        <a
          href="/safety-vests"
          class="inline-flex items-center gap-2 rounded-lg border border-white/60 px-7 py-3.5 text-sm font-bold text-white transition hover:bg-white/10 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-white"
        >
          Shop Safety Vests
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    gsap.from('[data-rise]', {
      y: 26,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
      stagger: 0.09,
    });

    /*
     * Start the background video only once motion is known to be welcome.
     * Injecting it rather than shipping it in the markup means a visitor who
     * prefers reduced motion pays nothing for it. No frame, no request, no
     * player, and simply sees the brand gradient, which the hero was designed
     * to stand on anyway.
     */
    const slot = document.querySelector('[data-hero-video-slot]');
    const template =
      document.querySelector<HTMLTemplateElement>('[data-hero-video]');
    if (slot && template) {
      slot.appendChild(template.content.cloneNode(true));
    }
  }
</script>
