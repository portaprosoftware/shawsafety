---
import Icon from '@components/ui/icons/Icon.astro';
import { trustMarks } from '@data/constants';
---

<section class="border-b border-neutral-200 bg-neutral-50">
  <div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-5 sm:px-6 lg:px-8">
    <ul
      class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 lg:justify-between"
    >
      {
        trustMarks.map(mark => (
          <li class="inline-flex items-center gap-2 text-sm font-semibold text-neutral-700">
            <Icon name={mark.icon} class="text-maroon-700 h-5 w-5 shrink-0" />
            {mark.label}
          </li>
        ))
      }
    </ul>
  </div>
</section>
