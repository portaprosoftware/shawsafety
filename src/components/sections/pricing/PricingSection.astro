---
import Icon from '@components/ui/icons/Icon.astro';
import { formatMoney } from '@scripts/pricing';

interface Props {
  title?: string;
  subTitle?: string;
  /** Hide the closing CTA when the section is embedded in a longer page. */
  showCta?: boolean;
  /**
   * Step the heading down a size and a weight. Used where the section sits
   * under a page title that already owns the top of the hierarchy, so the two
   * headings do not read as competing h1s.
   */
  compactHeading?: boolean;
  /**
   * Vertical rhythm for the section. Overridable so a page that already sets
   * its own spacing above the section can keep the gap balanced.
   */
  spacingClass?: string;
}

const {
  title = 'Simple, Transparent Pricing',
  subTitle = 'One price list, published up front. The discount applies automatically at checkout — no account, no negotiation, no minimum order.',
  showCta = true,
  compactHeading = false,
  spacingClass = 'py-16 lg:py-24',
} = Astro.props;

/**
 * The published price ladder for the lead SKU. Mirrors the tiers on the
 * 11-inch tie so the landing page and the PDP never disagree.
 */
const plans = [
  {
    name: 'Retail',
    range: '1–99 packs',
    price: 2.69,
    featured: false,
    badge: null,
    features: [
      'Free U.S. shipping',
      'Ships next business day',
      'All four fluorescent colors',
      'No account required',
    ],
    cta: {
      label: 'Shop Safety Ties',
      href: '/products/11-inch-zip-tie-100-pack',
    },
  },
  {
    name: 'Wholesale',
    range: '100+ packs',
    price: 2.19,
    featured: true,
    badge: 'Best value',
    features: [
      'Up to 19% off retail pricing',
      'Volume discount applied automatically',
      'Mixed colors count toward your tier',
      'Dedicated fulfillment queue',
      'Net terms available on request',
    ],
    cta: { label: 'Get a Bulk Quote', href: '/wholesale#quote' },
  },
];
---

<section class:list={[spacingClass]}>
  <div class="mx-auto max-w-2xl text-center">
    <h2
      class:list={[
        'tracking-tight text-neutral-900',
        compactHeading
          ? 'text-2xl font-semibold sm:text-3xl'
          : 'text-3xl font-bold sm:text-4xl lg:text-5xl',
      ]}
    >
      {title}
    </h2>
    <p class="mt-4 text-base text-neutral-600">{subTitle}</p>
  </div>

  <div class="mt-12 flex flex-col gap-5 sm:flex-row sm:justify-center">
    {
      plans.map(plan => (
        <div
          class:list={[
            'w-full rounded-xl p-6 shadow-xl sm:w-1/2 sm:max-w-md sm:p-8',
            plan.featured
              ? 'from-brand-grad-from to-brand-grad-to bg-linear-to-tr'
              : 'bg-neutral-900',
          ]}
        >
          <div class="flex items-center justify-between">
            <h3
              class:list={[
                'text-xl font-bold',
                plan.featured ? 'text-white' : 'text-white',
              ]}
            >
              {plan.name}
            </h3>
            {plan.badge && (
              <span class="rounded-full bg-white/20 px-3 py-1 text-xs font-bold text-white">
                {plan.badge}
              </span>
            )}
          </div>

          <p
            class:list={[
              'mt-1 text-sm',
              plan.featured ? 'text-white/80' : 'text-neutral-400',
            ]}
          >
            {plan.range}
          </p>

          <div class="mt-6 flex items-baseline gap-1.5">
            <span class="text-5xl font-bold tracking-tight text-white">
              {formatMoney(plan.price)}
            </span>
            <span
              class:list={[
                'text-sm',
                plan.featured ? 'text-white/80' : 'text-neutral-400',
              ]}
            >
              / 100-pack
            </span>
          </div>

          <ul class="mt-7 space-y-3">
            {plan.features.map(feature => (
              <li class="flex items-start gap-2.5">
                <Icon
                  name="checkCircle"
                  class:list={[
                    'mt-0.5 h-4 w-4 shrink-0',
                    plan.featured ? 'text-white' : 'text-maroon-400',
                  ]}
                />
                <span
                  class:list={[
                    'text-sm',
                    plan.featured ? 'text-white/90' : 'text-neutral-300',
                  ]}
                >
                  {feature}
                </span>
              </li>
            ))}
          </ul>

          <a
            href={plan.cta.href}
            class:list={[
              'mt-8 block rounded-lg px-5 py-3 text-center text-sm font-bold transition focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2',
              plan.featured
                ? 'text-maroon-900 bg-white hover:bg-neutral-100'
                : 'bg-maroon-700 hover:bg-maroon-600 text-white',
            ]}
          >
            {plan.cta.label}
          </a>
        </div>
      ))
    }
  </div>

  {
    showCta && (
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3 text-sm">
        <span class="font-semibold text-neutral-900">
          Ordering for a whole yard?
        </span>
        <a
          href="/wholesale#quote"
          class="group text-maroon-700 hover:text-maroon-800 inline-flex items-center gap-1.5 font-semibold underline underline-offset-4 transition"
        >
          Request a custom quote
          <Icon
            name="arrowRight"
            class="h-3.5 w-3.5 transition group-hover:translate-x-0.5"
          />
        </a>
      </div>
    )
  }
</section>
