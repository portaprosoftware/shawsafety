---
import type { CollectionEntry } from 'astro:content';
import Icon from '@components/ui/icons/Icon.astro';
import { formatMoney } from '@scripts/pricing';
import { resolveProductImage } from '@utils/productImages';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const p = product.data;
const variant = p.variants[0];
const tiers = variant.tiers ?? p.tiers;
const bestPrice = tiers[tiers.length - 1].pricePerUnit;

// The bagged shot reads better here than a single tie.
const image = await resolveProductImage(
  variant.images[2] ?? variant.images[0],
  700,
  700
);

const [left, right] = [p.highlights.slice(0, 3), p.highlights.slice(3, 6)];
---

<section class="bg-neutral-50 py-16 lg:py-24">
  <div class="mx-auto max-w-(--breakpoint-2xl) px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-10 lg:grid-cols-3 lg:gap-14">
      <div>
        <h2
          class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl"
        >
          High Visibility. High Strength.{' '}
          <span class="text-maroon-700">Great Price.</span>
        </h2>
        <p class="mt-4 text-neutral-600">
          Our fluorescent ties get the job done right, for less.
        </p>

        <div class="mt-8 space-y-6">
          {
            left.map(item => (
              <div class="flex gap-3.5">
                <Icon
                  name={item.icon}
                  class="text-maroon-700 mt-0.5 h-6 w-6 shrink-0"
                />
                <div>
                  <h3 class="text-sm font-bold tracking-wide text-neutral-900 uppercase">
                    {item.title}
                  </h3>
                  <p class="mt-1 text-sm leading-relaxed text-neutral-600">
                    {item.body}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="order-first lg:order-none">
        <img
          src={image.src}
          alt={`${p.shortTitle} in ${variant.name}`}
          width="700"
          height="700"
          loading="lazy"
          class="mx-auto aspect-square w-full max-w-[420px] rounded-xl border border-neutral-200 bg-white object-contain p-6"
        />
      </div>

      <div>
        <div class="space-y-6">
          {
            right.map(item => (
              <div class="flex gap-3.5">
                {/*
                 * Checks rather than each item's own icon: this column reads as
                 * a list of what you get, and the tie's fluorescent colour is
                 * invisible against the near-white section background once the
                 * swatch behind it is gone.
                 */}
                <Icon
                  name="checkCircle"
                  class="mt-0.5 h-6 w-6 shrink-0 text-green-600"
                />
                <div>
                  <h3 class="text-sm font-bold tracking-wide text-neutral-900 uppercase">
                    {item.title}
                  </h3>
                  <p class="mt-1 text-sm leading-relaxed text-neutral-600">
                    {item.body}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        <div
          class="mt-6 flex items-center gap-3.5 border-2 border-neutral-900 p-4"
        >
          <Icon
            name="refresh"
            class="h-6 w-6 shrink-0"
            style={`color:${variant.hex}`}
          />
          <div>
            <p
              class="text-sm font-bold tracking-wide text-neutral-900 uppercase"
            >
              Only <span class="text-lg">{formatMoney(bestPrice)}</span>/{
                p.unit
              }
            </p>
            <p class="text-sm text-neutral-600">
              {p.packSize}{' '}
              {p.subUnit ? `${p.subUnit}s` : 'units'} per {p.unit} at volume pricing
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
