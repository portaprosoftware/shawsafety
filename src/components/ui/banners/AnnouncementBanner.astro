---
interface Props {
  text?: string;
}

const { text = 'Free U.S. Shipping On Retail Orders' } = Astro.props;
---

<div class="bg-maroon-800 relative text-white">
  <p
    class="mx-auto max-w-(--breakpoint-2xl) px-4 py-2.5 text-center text-xs font-bold tracking-[0.18em] uppercase sm:px-6 lg:px-8"
  >
    {text}
  </p>
  {
    /*
     * Mobile-only progress sweep. A darker hairline crosses the banner every
     * 8s to signal that the message rotates — subtle enough to read as chrome
     * rather than a live loader. Hidden at `sm` and up, where desktop users
     * don't need the same cue and the wider layout can carry a static banner.
     */
  }
  <span
    aria-hidden="true"
    class="pointer-events-none absolute right-0 bottom-0 left-0 block h-px overflow-hidden sm:hidden"
  >
    <span class="bg-maroon-950/70 block h-full w-1/3 animate-[banner-sweep_8s_linear_infinite] will-change-transform"></span>
  </span>
</div>

<style>
  @keyframes banner-sweep {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(400%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-\[banner-sweep_8s_linear_infinite\] {
      animation: none;
    }
  }
</style>
