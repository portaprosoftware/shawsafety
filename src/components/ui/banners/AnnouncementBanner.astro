---
interface Props {
  text?: string;
}

const { text = 'Free U.S. Shipping On Retail Orders' } = Astro.props;
---

<div class="bg-maroon-800 text-white">
  <p
    class="mx-auto max-w-(--breakpoint-2xl) px-4 py-2.5 text-center text-xs font-bold tracking-[0.18em] uppercase sm:px-6 lg:px-8"
  >
    {text}
  </p>
</div>
