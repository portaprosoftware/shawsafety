---
/**
 * The announcement strip above the navbar.
 *
 * Two messages: the static free-shipping promise, and the live dispatch clock
 * from @scripts/shipCutoff ("Order within 2h 14m and it ships tomorrow").
 * The clock counts down to the real 5pm ET cutoff, so the banner states a
 * deadline that is actually approaching rather than a rule to work out.
 *
 * The server renders the timeless form of the promise as a fallback: the pages
 * are prerendered, so any countdown baked in at build would be stale before it
 * was ever read. The script replaces it the moment it runs; without JavaScript
 * the fallback stands and is still true.
 */
interface Props {
  /** Static messages shown ahead of the dispatch clock. */
  messages?: string[];
}

const { messages = ['Free Shipping On U.S. Orders'] } = Astro.props;

const CUTOFF_FALLBACK = 'Order by 5pm ET and it ships the next business day';
---

<div class="bg-maroon-800 text-white">
  <div
    class="announcement-banner mx-auto max-w-(--breakpoint-2xl) px-4 py-2.5 text-center text-xs font-bold tracking-[0.18em] uppercase sm:px-6 lg:px-8"
    data-announcement-banner
    data-messages={JSON.stringify(messages)}
  >
    <div class="announcement-banner__joined" data-joined>
      {
        messages.map((msg, i) => (
          <>
            {i > 0 && (
              <span class="announcement-banner__dot" aria-hidden="true">
                &bull;
              </span>
            )}
            <span>{msg}</span>
          </>
        ))
      }
      <span class="announcement-banner__dot" aria-hidden="true">&bull;</span>
      <span data-ship-cutoff>{CUTOFF_FALLBACK}</span>
    </div>
    <div class="announcement-banner__rotator" data-rotator hidden>
      <span data-rotator-text>{messages[0]}</span>
    </div>
  </div>
</div>

<style>
  .announcement-banner__joined {
    white-space: nowrap;
  }
  .announcement-banner__dot {
    display: inline-block;
    margin: 0 0.75em;
    opacity: 0.8;
  }
  .announcement-banner__rotator {
    white-space: nowrap;
  }
  [hidden] {
    display: none !important;
  }
</style>

<script>
  import { onShipCutoffTick, shipCutoffMessage } from '@scripts/shipCutoff';

  const ROTATE_MS = 8000;

  function init(container: HTMLElement) {
    const joined = container.querySelector<HTMLElement>('[data-joined]');
    const rotator = container.querySelector<HTMLElement>('[data-rotator]');
    const rotatorText = container.querySelector<HTMLElement>(
      '[data-rotator-text]'
    );
    const cutoffSpan =
      container.querySelector<HTMLElement>('[data-ship-cutoff]');
    if (!joined || !rotator || !rotatorText) return;

    let staticMessages: string[] = [];
    try {
      staticMessages = JSON.parse(container.dataset.messages || '[]');
    } catch {
      staticMessages = [];
    }

    /*
     * The clock message is recomputed on read rather than cached, so the
     * rotator never redisplays a countdown from a previous cycle.
     */
    const allMessages = () => [...staticMessages, shipCutoffMessage()];
    const cutoffIndex = staticMessages.length;

    let rotating = false;
    let idx = 0;
    let timer: number | null = null;

    function startRotation() {
      if (rotating) return;
      rotating = true;
      joined!.hidden = true;
      rotator!.hidden = false;
      idx = 0;
      rotatorText!.textContent = allMessages()[0];
      timer = window.setInterval(() => {
        const messages = allMessages();
        idx = (idx + 1) % messages.length;
        rotatorText!.textContent = messages[idx];
      }, ROTATE_MS);
    }

    function stopRotation() {
      if (!rotating) return;
      rotating = false;
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
      rotator!.hidden = true;
      joined!.hidden = false;
    }

    function measure() {
      // Temporarily show the joined version to measure.
      const wasRotating = rotating;
      joined!.hidden = false;
      // Force layout read.
      const overflow = joined!.scrollWidth > joined!.clientWidth + 1;
      if (wasRotating) joined!.hidden = true;

      if (overflow) {
        startRotation();
      } else {
        stopRotation();
      }
    }

    // Keep both renderings of the clock current: the joined span always, and
    // the rotator only while it is the message on display.
    onShipCutoffTick(message => {
      if (cutoffSpan) cutoffSpan.textContent = message;
      if (rotating && idx === cutoffIndex) rotatorText!.textContent = message;
    });

    measure();

    let raf = 0;
    const onResize = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(measure);
    };
    window.addEventListener('resize', onResize);
    if ('ResizeObserver' in window) {
      new ResizeObserver(onResize).observe(container);
    }
  }

  function boot() {
    document
      .querySelectorAll<HTMLElement>('[data-announcement-banner]')
      .forEach(init);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
