---
import { Icons } from './icons.ts';

interface Props {
  name: string;
  class?: string;
  /** Stroke width; nudge up for small sizes where hairlines disappear. */
  strokeWidth?: number;
  /**
   * Escape hatch for colours that cannot be a token — the fluorescent product
   * colours come from content as raw hex. Prefer a `text-*` class otherwise.
   */
  style?: string;
}

const {
  name,
  class: className = 'h-6 w-6',
  strokeWidth = 1.75,
  style,
} = Astro.props;

const icon = Icons[name];

if (!icon) {
  throw new Error(
    `Icon "${name}" is not in the registry (src/components/ui/icons/icons.ts).`
  );
}
---

<svg
  class={className}
  style={style}
  viewBox="0 0 24 24"
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width={icon.fill ? 0 : strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {icon.paths.map((d: string) => <path d={d} />)}
  {icon.extra && <Fragment set:html={icon.extra} />}
</svg>
