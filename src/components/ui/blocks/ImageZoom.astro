---
import Icon from '@components/ui/icons/Icon.astro';

interface Props {
  /** Source rendered larger than its display size, so zooming stays sharp. */
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

{
  /*
  The product image stays at a restrained size — the reference site blows these
  up full-bleed, which buries the buy box below the fold. Detail comes from
  magnifying the image in place under the cursor rather than opening a separate
  viewer, which loses your position on the page.
*/
}
<div class="mx-auto w-full max-w-[560px]">
  <div
    data-zoom-container
    class="group relative aspect-square cursor-zoom-in overflow-hidden rounded-xl border border-neutral-200 bg-white"
  >
    <img
      data-zoom-image
      src={src}
      alt={alt}
      width="1100"
      height="1100"
      loading="eager"
      draggable="false"
      class="absolute inset-0 h-full w-full object-contain p-6 transition-transform duration-200 ease-out will-change-transform select-none"
    />

    <span
      data-zoom-hint
      class="pointer-events-none absolute right-3 bottom-3 inline-flex items-center gap-1.5 rounded-full bg-neutral-900 px-3 py-1.5 text-xs font-semibold text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100"
    >
      <Icon name="zoomIn" class="h-3.5 w-3.5" />
      <span data-zoom-hint-text>Hover to zoom</span>
    </span>
  </div>
</div>

<script>
  /**
   * In-place magnifier.
   *
   * Scales the image about the point under the cursor, so the area you are
   * pointing at is what grows. Deliberately modest: enough to read a moulding
   * mark, not so much that you lose track of what you are looking at.
   */
  const ZOOM = 1.75;

  const container = document.querySelector<HTMLElement>(
    '[data-zoom-container]'
  );
  const image = document.querySelector<HTMLImageElement>('[data-zoom-image]');
  const hintText = document.querySelector<HTMLElement>('[data-zoom-hint-text]');

  if (container && image) {
    // Coarse pointers have no hover, so there tapping toggles the zoom.
    const canHover = window.matchMedia('(hover: hover)').matches;
    let zoomed = false;

    if (hintText && !canHover) hintText.textContent = 'Tap to zoom';

    /** Move the transform origin to the pointer, as a percentage of the box. */
    const trackTo = (event: PointerEvent) => {
      const box = container.getBoundingClientRect();
      const x = ((event.clientX - box.left) / box.width) * 100;
      const y = ((event.clientY - box.top) / box.height) * 100;
      // Clamp so a pointer at the very edge does not push the origin outside.
      image.style.transformOrigin = `${Math.min(100, Math.max(0, x))}% ${Math.min(100, Math.max(0, y))}%`;
    };

    const zoomIn = (event: PointerEvent) => {
      zoomed = true;
      trackTo(event);
      image.style.transform = `scale(${ZOOM})`;
      container.classList.replace('cursor-zoom-in', 'cursor-zoom-out');
    };

    const zoomOut = () => {
      zoomed = false;
      image.style.transform = '';
      // Return to centre so the reset animates predictably.
      image.style.transformOrigin = '50% 50%';
      container.classList.replace('cursor-zoom-out', 'cursor-zoom-in');
    };

    if (canHover) {
      container.addEventListener('pointerenter', zoomIn);
      container.addEventListener('pointermove', event => {
        if (zoomed) trackTo(event);
      });
      container.addEventListener('pointerleave', zoomOut);
    } else {
      container.addEventListener('pointerdown', event => {
        if (zoomed) zoomOut();
        else zoomIn(event);
      });
      container.addEventListener('pointermove', event => {
        // Dragging while zoomed pans the magnified view.
        if (!zoomed) return;
        event.preventDefault();
        trackTo(event);
      });
    }

    // Keyboard and assistive tech get the same escape hatch as a tap.
    container.addEventListener('keydown', event => {
      if (event.key === 'Escape' && zoomed) zoomOut();
    });

    /*
     * Switching colour swaps the src on this same element. A stale zoom would
     * leave the new photo scaled and off-centre, so reset whenever it changes.
     */
    new MutationObserver(() => {
      if (zoomed) zoomOut();
    }).observe(image, { attributes: true, attributeFilter: ['src'] });
  }
</script>
