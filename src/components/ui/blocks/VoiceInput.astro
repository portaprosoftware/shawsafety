---
/**
 * Dictation for multi-line form fields.
 *
 * Drop this component on any page that has a `<textarea>` and every one of
 * them gets a microphone. There is no per-field markup to add or keep in
 * sync, so a field added later is covered automatically. Single-line inputs
 * are deliberately left alone: a name or an email address is faster to type
 * than to speak and correct.
 */
import Icon from '@components/ui/icons/Icon.astro';
---

{
  /*
  The button is built from this template rather than written in JavaScript, so
  the icons stay in the registry with every other icon instead of becoming a
  second copy of the same paths inlined in a script.

  Hidden until the script clones it, and if the browser cannot record, it is
  never cloned, so no dead control is shown.
*/
}
<template data-voice-template>
  {
    /*
    The control sits in the bottom-right corner of the field it fills, so it
    reads as part of the box rather than another button stacked under the
    form. That leaves no room for a caption, so "Speak" moves to the
    accessible name, the microphone alone is understood, and the label was
    the widest thing in the row.
  */
  }
  <button
    type="button"
    data-voice-button
    class="focus-visible:ring-maroon-700 absolute right-2 bottom-2 inline-flex h-8 w-8 items-center justify-center rounded-lg border border-neutral-300 bg-white text-neutral-600 transition hover:border-neutral-400 hover:bg-neutral-50 hover:text-neutral-900 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-1 disabled:cursor-not-allowed disabled:opacity-50"
  >
    <span data-voice-icon-idle class="contents">
      <Icon name="microphone" class="h-4 w-4" strokeWidth={2} />
    </span>
    <span data-voice-icon-recording class="contents hidden">
      <Icon name="stop" class="h-4 w-4 text-red-600" />
    </span>
    <span data-voice-label class="sr-only">Speak</span>

    {
      /*
      Radio-wave rings while recording. Two staggered animate-ping layers so
      it reads as an emanating wave, not a single throb. Positioned as
      children of the (already position:absolute) button, so `absolute inset-0`
      resolves against the button box and the pulse extends into the space
      around it. aria-hidden and pointer-events:none so nothing interferes
      with focus or the click path; class-hidden when idle so the paint cost
      is zero the rest of the time.
    */
    }
    <span
      data-voice-rings
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 hidden"
    >
      <span
        class="absolute inset-0 animate-ping rounded-lg ring-2 ring-red-500/60"
      ></span>
      <span
        class="absolute inset-0 animate-ping rounded-lg ring-2 ring-red-500/40"
        style="animation-delay:0.6s"></span>
    </span>
  </button>

  {/* aria-live so the state change is announced, not just drawn. */}
  <p
    data-voice-status
    class="mt-1.5 text-xs text-neutral-500"
    role="status"
    aria-live="polite"
  >
  </p>
</template>

<script>
  /**
   * Wires a dictation control to every textarea on the page.
   *
   * The recording and transcription itself lives in @scripts/dictation, shared
   * with the chat composer. This file is only the form-field chrome: where the
   * button sits, what it looks like mid-recording, and where the status line
   * goes.
   */
  import {
    createDictation,
    insertAtCaret,
    isDictationSupported,
  } from '@scripts/dictation';

  interface Elements {
    button: HTMLButtonElement;
    label: HTMLElement;
    status: HTMLElement;
    idle: HTMLElement;
    recording: HTMLElement;
    rings: HTMLElement;
  }

  function attach(field: HTMLTextAreaElement, template: HTMLTemplateElement) {
    const fragment = template.content.cloneNode(true) as DocumentFragment;

    const el: Elements = {
      button: fragment.querySelector('[data-voice-button]')!,
      label: fragment.querySelector('[data-voice-label]')!,
      status: fragment.querySelector('[data-voice-status]')!,
      idle: fragment.querySelector('[data-voice-icon-idle]')!,
      recording: fragment.querySelector('[data-voice-icon-recording]')!,
      rings: fragment.querySelector('[data-voice-rings]')!,
    };

    /*
     * The button is positioned against the field, which means the field needs
     * a positioned parent. Wrapping here rather than in every form keeps the
     * "add a textarea and it just works" contract, the markup around the
     * field stays untouched, and the extra bottom padding stops a long
     * message from running underneath the microphone.
     */
    const wrapper = document.createElement('div');
    wrapper.className = 'relative';
    field.insertAdjacentElement('beforebegin', wrapper);
    wrapper.appendChild(field);
    wrapper.appendChild(el.button);
    field.classList.add('pb-12');

    // The status line belongs to the field, not inside its box.
    wrapper.insertAdjacentElement('afterend', el.status);

    // Name the control after the field it fills, so a screen reader hearing
    // "Speak" on a page with two of them knows which is which.
    const fieldName =
      document
        .querySelector<HTMLLabelElement>(`label[for="${field.id}"]`)
        ?.textContent?.trim() ?? 'this field';
    el.button.setAttribute('aria-label', `Dictate ${fieldName}`);
    // The transcript lands in the textarea, so point assistive tech at it.
    el.button.setAttribute('aria-controls', field.id);

    const dictation = createDictation({
      onText: text => insertAtCaret(field, text),
      onStatus: (text, isError) => {
        el.status.textContent = text;
        el.status.classList.toggle('text-red-600', isError);
        el.status.classList.toggle('text-neutral-500', !isError);
      },
      onRecordingChange: on => {
        el.idle.classList.toggle('hidden', on);
        el.recording.classList.toggle('hidden', !on);
        el.label.textContent = on ? 'Stop' : 'Speak';
        el.button.setAttribute('aria-pressed', String(on));
        el.button.classList.toggle('border-red-400', on);
        el.button.classList.toggle('bg-red-50', on);
        el.rings.classList.toggle('hidden', !on);
      },
      onBusyChange: busy => {
        el.button.disabled = busy;
      },
    });

    el.button.addEventListener('click', dictation.toggle);
  }

  const template = document.querySelector<HTMLTemplateElement>(
    '[data-voice-template]'
  );

  /*
   * Where recording is unavailable the button is simply never created, the
   * forms are fully usable by typing, so a control that cannot work is worse
   * than no control.
   */
  if (template && isDictationSupported()) {
    document
      .querySelectorAll<HTMLTextAreaElement>('textarea')
      .forEach(field => {
        // A honeypot textarea is hidden from people and should stay that way.
        if (field.closest('[aria-hidden="true"]') || field.hidden) return;
        /*
         * An explicit opt-out, for fields that live outside this page's forms.
         * The chat widget is in the layout and so appears on every page, while
         * this component is only on two of them. Without the opt-out its
         * composer would sprout a Speak button on the contact and wholesale
         * pages and nowhere else, which is worse than not offering it at all.
         */
        if (field.hasAttribute('data-no-dictation')) return;
        attach(field, template);
      });
  }
</script>
