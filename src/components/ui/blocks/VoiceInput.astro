---
/**
 * Dictation for multi-line form fields.
 *
 * Drop this component on any page that has a `<textarea>` and every one of
 * them gets a microphone — there is no per-field markup to add or keep in
 * sync, so a field added later is covered automatically. Single-line inputs
 * are deliberately left alone: a name or an email address is faster to type
 * than to speak and correct.
 */
import Icon from '@components/ui/icons/Icon.astro';
---

{
  /*
  The button is built from this template rather than written in JavaScript, so
  the icons stay in the registry with every other icon instead of becoming a
  second copy of the same paths inlined in a script.

  Hidden until the script clones it — and if the browser cannot record, it is
  never cloned, so no dead control is shown.
*/
}
<template data-voice-template>
  {
    /*
    The control sits in the bottom-right corner of the field it fills, so it
    reads as part of the box rather than another button stacked under the
    form. That leaves no room for a caption, so "Speak" moves to the
    accessible name — the microphone alone is understood, and the label was
    the widest thing in the row.
  */
  }
  <button
    type="button"
    data-voice-button
    class="focus-visible:ring-maroon-700 absolute right-2 bottom-2 inline-flex h-8 w-8 items-center justify-center rounded-lg border border-neutral-300 bg-white text-neutral-600 transition hover:border-neutral-400 hover:bg-neutral-50 hover:text-neutral-900 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-1 disabled:cursor-not-allowed disabled:opacity-50"
  >
    <span data-voice-icon-idle class="contents">
      <Icon name="microphone" class="h-4 w-4" strokeWidth={2} />
    </span>
    <span data-voice-icon-recording class="contents hidden">
      <Icon name="stop" class="h-4 w-4 text-red-600" />
    </span>
    <span data-voice-label class="sr-only">Speak</span>
  </button>

  {/* aria-live so the state change is announced, not just drawn. */}
  <p
    data-voice-status
    class="mt-1.5 text-xs text-neutral-500"
    role="status"
    aria-live="polite"
  >
  </p>
</template>

<script>
  /**
   * Wires a dictation control to every textarea on the page.
   *
   * Audio is recorded in the browser, normalised to WAV, and posted to
   * /api/transcribe, which holds the ElevenLabs key. Nothing is stored: the
   * blob is discarded once the text comes back.
   */
  import { toWav } from '@scripts/wavEncoder';

  /** Auto-stop, in ms. A forgotten open mic is a bill and a privacy problem. */
  const MAX_RECORDING_MS = 120_000;

  interface Elements {
    button: HTMLButtonElement;
    label: HTMLElement;
    status: HTMLElement;
    idle: HTMLElement;
    recording: HTMLElement;
  }

  /**
   * Pick a container the browser will actually produce.
   *
   * Chrome and Firefox record WebM/Opus; Safari ignores the request and gives
   * MP4. Passing an unsupported type throws, so an empty string (meaning "your
   * default") is the honest fallback rather than a guess.
   */
  function preferredMimeType(): string {
    const candidates = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'];
    return candidates.find(type => MediaRecorder.isTypeSupported(type)) ?? '';
  }

  /**
   * Insert transcribed text at the caret, keeping whatever is already typed.
   *
   * Dictation is for adding to a field, not replacing it — someone who typed
   * two sentences and then spoke a third should end up with three.
   */
  function insertAtCaret(field: HTMLTextAreaElement, text: string): void {
    const start = field.selectionStart ?? field.value.length;
    const end = field.selectionEnd ?? start;
    const before = field.value.slice(0, start);
    const after = field.value.slice(end);

    // Space out from adjacent text, so speaking twice does not run words
    // together — but never open the field with a leading space.
    const lead = before && !/\s$/.test(before) ? ' ' : '';
    const trail = after && !/^\s/.test(after) ? ' ' : '';
    const insert = `${lead}${text}${trail}`;

    field.value = `${before}${insert}${after}`;

    const caret = start + insert.length - trail.length;
    field.setSelectionRange(caret, caret);
    field.focus();

    // Anything watching the field (validation, autosize, character counts)
    // listens for input events, which programmatic writes do not raise.
    field.dispatchEvent(new Event('input', { bubbles: true }));
  }

  function attach(field: HTMLTextAreaElement, template: HTMLTemplateElement) {
    const fragment = template.content.cloneNode(true) as DocumentFragment;

    const el: Elements = {
      button: fragment.querySelector('[data-voice-button]')!,
      label: fragment.querySelector('[data-voice-label]')!,
      status: fragment.querySelector('[data-voice-status]')!,
      idle: fragment.querySelector('[data-voice-icon-idle]')!,
      recording: fragment.querySelector('[data-voice-icon-recording]')!,
    };

    /*
     * The button is positioned against the field, which means the field needs
     * a positioned parent. Wrapping here rather than in every form keeps the
     * "add a textarea and it just works" contract — the markup around the
     * field stays untouched, and the extra bottom padding stops a long
     * message from running underneath the microphone.
     */
    const wrapper = document.createElement('div');
    wrapper.className = 'relative';
    field.insertAdjacentElement('beforebegin', wrapper);
    wrapper.appendChild(field);
    wrapper.appendChild(el.button);
    field.classList.add('pb-12');

    // The status line belongs to the field, not inside its box.
    wrapper.insertAdjacentElement('afterend', el.status);

    // Name the control after the field it fills, so a screen reader hearing
    // "Speak" on a page with two of them knows which is which.
    const fieldName =
      document
        .querySelector<HTMLLabelElement>(`label[for="${field.id}"]`)
        ?.textContent?.trim() ?? 'this field';
    el.button.setAttribute('aria-label', `Dictate ${fieldName}`);
    // The transcript lands in the textarea, so point assistive tech at it.
    el.button.setAttribute('aria-controls', field.id);

    let recorder: MediaRecorder | null = null;
    let stream: MediaStream | null = null;
    let chunks: Blob[] = [];
    let timer: number | undefined;
    let autoStop: number | undefined;
    let startedAt = 0;

    const setStatus = (text: string, isError = false) => {
      el.status.textContent = text;
      el.status.classList.toggle('text-red-600', isError);
      el.status.classList.toggle('text-neutral-500', !isError);
    };

    const showRecording = (on: boolean) => {
      el.idle.classList.toggle('hidden', on);
      el.recording.classList.toggle('hidden', !on);
      el.label.textContent = on ? 'Stop' : 'Speak';
      el.button.setAttribute('aria-pressed', String(on));
      el.button.classList.toggle('border-red-400', on);
      el.button.classList.toggle('bg-red-50', on);
    };

    /** Drop the mic. Without this the browser keeps showing "recording". */
    const releaseMic = () => {
      stream?.getTracks().forEach(track => track.stop());
      stream = null;
      window.clearInterval(timer);
      window.clearTimeout(autoStop);
    };

    const tick = () => {
      const seconds = Math.floor((Date.now() - startedAt) / 1000);
      const mm = String(Math.floor(seconds / 60)).padStart(2, '0');
      const ss = String(seconds % 60).padStart(2, '0');
      setStatus(`Recording ${mm}:${ss} — click Stop when finished`);
    };

    const transcribe = async (recorded: Blob) => {
      el.button.disabled = true;
      setStatus('Transcribing…');

      /*
       * Convert to WAV before uploading. Browsers record in whatever container
       * they prefer, and the parameterised type that comes with it
       * (`audio/webm;codecs=opus`) is what upstream rejected with an opaque
       * 400. WAV has no codec parameter and is accepted everywhere.
       *
       * If the browser cannot decode its own recording, send the original —
       * the recorder's format may well transcribe fine, and a failed
       * conversion is no reason to throw the audio away.
       */
      let blob = recorded;
      let filename = recorded.type.includes('mp4')
        ? 'recording.mp4'
        : 'recording.webm';
      try {
        blob = await toWav(recorded);
        filename = 'recording.wav';
      } catch (error) {
        console.warn('[voice] WAV conversion failed, sending original:', error);
      }

      const body = new FormData();
      body.append('audio', blob, filename);

      try {
        const response = await fetch('/api/transcribe', {
          method: 'POST',
          body,
        });
        const payload = await response
          .json()
          .catch(() => ({ ok: false, error: '' }));

        if (!response.ok || !payload.ok) {
          setStatus(
            payload.error || 'Transcription failed. Please type.',
            true
          );
          return;
        }

        insertAtCaret(field, payload.text);
        setStatus('Added. Edit as needed.');
      } catch {
        // Offline, or the request was cut off mid-flight.
        setStatus('Network problem — the recording was not sent.', true);
      } finally {
        el.button.disabled = false;
      }
    };

    const stop = () => {
      // `stop()` fires onstop asynchronously; releasing the mic here rather
      // than in the handler kills the recording light immediately.
      recorder?.state === 'recording' && recorder.stop();
      releaseMic();
      showRecording(false);
    };

    const start = async () => {
      setStatus('Requesting microphone…');
      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      } catch (error) {
        // Denied, dismissed, or no input device — all land here, and the
        // distinction is what the visitor needs to hear.
        const denied =
          error instanceof DOMException &&
          (error.name === 'NotAllowedError' || error.name === 'SecurityError');
        setStatus(
          denied
            ? 'Microphone blocked. Allow access in your browser, or type instead.'
            : 'No microphone found. Please type instead.',
          true
        );
        return;
      }

      const mimeType = preferredMimeType();
      recorder = new MediaRecorder(stream, mimeType ? { mimeType } : undefined);
      chunks = [];

      recorder.addEventListener('dataavailable', event => {
        if (event.data.size > 0) chunks.push(event.data);
      });

      recorder.addEventListener('stop', () => {
        const blob = new Blob(chunks, {
          type: recorder?.mimeType || 'audio/webm',
        });
        chunks = [];
        if (blob.size > 0) void transcribe(blob);
        else setStatus('Nothing was recorded. Try again.', true);
      });

      recorder.start();
      startedAt = Date.now();
      showRecording(true);
      tick();
      timer = window.setInterval(tick, 1000);
      autoStop = window.setTimeout(() => {
        stop();
        setStatus('Reached the 2 minute limit — transcribing what was said.');
      }, MAX_RECORDING_MS);
    };

    el.button.addEventListener('click', () => {
      if (recorder?.state === 'recording') stop();
      else void start();
    });

    // Leaving mid-recording must not strand an open microphone.
    window.addEventListener('pagehide', releaseMic);
  }

  const template = document.querySelector<HTMLTemplateElement>(
    '[data-voice-template]'
  );

  /*
   * Recording needs both APIs and a secure context; getUserMedia is undefined
   * over plain HTTP. Where any of that is missing the button is simply never
   * created — the forms are fully usable by typing, so a control that cannot
   * work is worse than no control.
   */
  const supported =
    typeof MediaRecorder !== 'undefined' &&
    typeof navigator.mediaDevices?.getUserMedia === 'function';

  if (template && supported) {
    document
      .querySelectorAll<HTMLTextAreaElement>('textarea')
      .forEach(field => {
        // A honeypot textarea is hidden from people and should stay that way.
        if (field.closest('[aria-hidden="true"]') || field.hidden) return;
        /*
         * An explicit opt-out, for fields that live outside this page's forms.
         * The chat widget is in the layout and so appears on every page, while
         * this component is only on two of them — without the opt-out its
         * composer would sprout a Speak button on the contact and wholesale
         * pages and nowhere else, which is worse than not offering it at all.
         */
        if (field.hasAttribute('data-no-dictation')) return;
        attach(field, template);
      });
  }
</script>
