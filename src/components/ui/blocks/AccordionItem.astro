---
import Icon from '@components/ui/icons/Icon.astro';

interface Props {
  id: string;
  collapseId: string;
  question: string;
  answer: string;
  first?: boolean;
}

const { id, collapseId, question, answer, first = false } = Astro.props;
---

<div class:list={['hs-accordion py-1', first && 'active']} id={id}>
  <button
    class="hs-accordion-toggle group hover:text-maroon-700 focus-visible:ring-maroon-700 inline-flex w-full items-center justify-between gap-x-3 rounded-lg py-4 text-start font-bold text-balance text-neutral-900 outline-hidden transition focus-visible:ring-2 md:text-lg"
    aria-expanded={first}
    aria-controls={collapseId}
  >
    {question}
    <Icon
      name="chevronDown"
      class="group-hover:text-maroon-700 hs-accordion-active:rotate-180 h-5 w-5 shrink-0 text-neutral-400 transition-transform duration-300"
    />
  </button>
  <div
    id={collapseId}
    role="region"
    aria-labelledby={id}
    class:list={[
      'hs-accordion-content w-full overflow-hidden transition-[height] duration-300',
      !first && 'hidden',
    ]}
  >
    <p class="pb-4 leading-relaxed text-pretty text-neutral-600">
      {answer}
    </p>
  </div>
</div>
