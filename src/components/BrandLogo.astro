---
/**
 * Shaw Safety wordmark. Pure inline SVG so it inherits `currentColor` and
 * stays crisp at any size — no raster asset to keep in sync.
 */
interface Props {
  class?: string;
}

const { class: className = 'h-8 w-auto' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 260 40"
  fill="none"
  role="img"
  aria-label="Shaw Safety"
>
  <title>Shaw Safety</title>
  {/* Zip-tie glyph: head block plus tapered, ridged tail. */}
  <g stroke="currentColor" stroke-width="2.6" stroke-linejoin="round">
    <rect x="2" y="12.5" width="13" height="15" rx="3"></rect>
    <path d="M7 17.5v5" stroke-linecap="round"></path>
  </g>
  <path d="M15 16.5h18l-2.5 7H15z" fill="currentColor" opacity="0.55"></path>
  {/* Wordmark: heavy italic condensed, matching the storefront signage. */}
  <text
    x="40"
    y="30"
    fill="currentColor"
    font-family="'Helvetica Neue', Helvetica, Arial, sans-serif"
    font-size="27"
    font-weight="800"
    font-style="italic"
    letter-spacing="-0.6"
  >
    SHAW SAFETY
  </text>
</svg>
