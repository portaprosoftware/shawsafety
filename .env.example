# Copy to `.env` for local development. In production these are set in
# Vercel → Project → Settings → Environment Variables.
#
# .env is gitignored. Never commit real keys.

# Resend API key, used by src/pages/api/contact.ts. Server-only: it is read in
# an API route and never reaches the browser. Do NOT prefix it with PUBLIC_,
# which would expose it to the client.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The From address on outgoing mail. Must be on a domain verified in Resend, or
# the API rejects the send. Resend's onboarding@resend.dev works for testing.
RESEND_FROM="Shaw Safety <sales@shawsafety.com>"

# Where form submissions are delivered. Comma-separated for several recipients:
#   CONTACT_TO=someone@example.com,someone-else@example.com
# Whitespace around commas is fine. Entries that are not valid addresses are
# dropped. Optional — defaults to sales@shawsafety.com if unset.
#
# Real addresses are deliberately not committed here; set the value in Vercel.
CONTACT_TO=sales@shawsafety.com
