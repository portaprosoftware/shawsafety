# Copy to `.env` for local development. In production these are set in
# Vercel → Project → Settings → Environment Variables.
#
# .env is gitignored. Never commit real keys.

# Resend API key, used by src/pages/api/contact.ts. Server-only: it is read in
# an API route and never reaches the browser. Do NOT prefix it with PUBLIC_,
# which would expose it to the client.
# Starts with "re_".
RESEND_API_KEY=

# The From address on outgoing mail. Must be on a domain verified in Resend, or
# the API rejects the send. Resend's onboarding@resend.dev works for testing.
RESEND_FROM="Shaw Safety <sales@shawsafety.com>"

# Where form submissions are delivered. Comma-separated for several recipients:
#   CONTACT_TO=someone@example.com,someone-else@example.com
# Whitespace around commas is fine. Entries that are not valid addresses are
# dropped. Optional — defaults to sales@shawsafety.com if unset.
#
# Real addresses are deliberately not committed here; set the value in Vercel.
CONTACT_TO=sales@shawsafety.com

# ── Stripe checkout (src/pages/api/checkout.ts) ─────────────────────────────

# Secret key from https://dashboard.stripe.com/apikeys — starts with "sk_test_"
# for test mode or "sk_live_" for production. Server-only; never prefix with
# PUBLIC_. Left blank here on purpose: a realistic-looking placeholder trips
# GitHub's secret scanning and blocks the push.
STRIPE_SECRET_KEY=

# One Price ID per purchasable variant. A variant with no Price ID here cannot
# be bought online; checkout reports it by name instead of failing obscurely.
# Names must match exactly — the mapping is src/utils/stripePrices.ts.
# Price IDs start with "price_" and come from the Product in Stripe.
#
# All four tie colours are live. The vests are not yet set up.
STRIPE_PRICE_YELLOW=
STRIPE_PRICE_PINK=
STRIPE_PRICE_GREEN=
STRIPE_PRICE_ORANGE=
# STRIPE_PRICE_VEST_LIME=
# STRIPE_PRICE_VEST_ORANGE=

# ── Dictation (src/pages/api/transcribe.ts) ────────────────────────────────

# ElevenLabs API key, powering the microphone button on multi-line form
# fields. Server-only: audio is posted to our own route, which forwards it —
# the key never reaches the browser. Do NOT prefix with PUBLIC_.
#
# Optional. With no key the button reports that dictation is unavailable and
# the form still works by typing.
ELEVENLABS_API_KEY=

# ── RAG assistant (src/pages/api/ask.ts, scripts/build-rag-index.mjs) ──────

# OpenAI API key. Used in two places, both server-side: the /api/ask route
# (embeds the question, then answers from retrieved passages) and the
# `pnpm rag:index` script that embeds the corpus. Server-only: it is read in an
# API route and never reaches the browser. Do NOT prefix with PUBLIC_.
# Starts with "sk-".
#
# Optional. With no key /api/ask reports that the assistant is unconfigured
# and points the visitor at sales@shawsafety.com; nothing else on the site is
# affected.
OPENAI_API_KEY=

# Model overrides. Defaults are fine — set these only to change tier or cost.
# The embedding model must match the one the committed index was built with,
# so changing it means re-running `pnpm rag:index` and committing the result.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Signing secret for the Stripe webhook at /api/stripe-webhook, with the
# `checkout.session.completed` event enabled. Verifies that the payload really
# came from Stripe. Starts with "whsec_".
STRIPE_CHECKOUT_WEBHOOK_SECRET=
