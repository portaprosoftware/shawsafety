# Copy to `.env` for local development. In production these are set in
# Vercel → Project → Settings → Environment Variables.
#
# .env is gitignored. Never commit real keys.

# ── Sending mail (src/pages/api/contact.ts) ─────────────────────────────────

# Resend API key. Server-only: it is read in an API route and never reaches the
# browser. Do NOT prefix it with PUBLIC_, which would expose it to the client.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The From address on outgoing mail. Must be on a domain verified in Resend, or
# the API rejects the send. Resend's onboarding@resend.dev works for testing.
RESEND_FROM="Shaw Safety <sales@shawsafety.com>"

# Where form submissions are delivered. Optional — defaults to
# sales@shawsafety.com if unset.
CONTACT_TO=sales@shawsafety.com

# ── Receiving delivery events (src/pages/api/resend-webhook.ts) ─────────────

# Signing secret for the webhook at https://resend.com/webhooks, pointed at
# https://shawsafety.com/api/resend-webhook. Used only to verify that inbound
# event POSTs really came from Resend — it plays no part in sending.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
